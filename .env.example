# Local Docker Compose configuration. Copy this file to .env; never add secrets
# or machine-specific credentials to this template.

# Stable Compose project name used to namespace local containers, networks, and
# volumes when the dependency topology is introduced by issue #21.
COMPOSE_PROJECT_NAME=videogame-platform

# No credentials are required by the current prerequisite-only environment.
# Future required variables must be documented here with non-secret placeholders;
# their real values belong only in the ignored local .env file or a secret store.
