# Local Docker Compose configuration reference. The repository wrapper creates an
# ignored .env with generated credentials on first startup. Never commit that file.

# Fixed Compose project name used to namespace local containers, networks, and
# volumes. The lifecycle wrapper rejects another value so reset cannot target an
# unrelated project.
COMPOSE_PROJECT_NAME=videogame-platform

# PostgreSQL binds only to the local workstation and uses SCRAM-SHA-256 for host
# connections. Each role has an independently generated password in .env; these
# values are documentation placeholders only.
POSTGRES_PORT=5432
POSTGRES_ADMIN_PASSWORD=GENERATE_ME
APPLICATION_DB_PASSWORD=GENERATE_ME
APPLICATION_MIGRATION_DB_PASSWORD=GENERATE_ME
APPLICATION_DB_CONNECTION_TIMEOUT=3000
APPLICATION_DB_VALIDATION_TIMEOUT=1000
APPLICATION_DB_MAXIMUM_POOL_SIZE=10
CATALOGUE_JDBC_READ_TIMEOUT=5s
KEYCLOAK_DB_PASSWORD=GENERATE_ME

# Keycloak uses 8180 so the application can keep its conventional local port 8080.
# The management port exposes local health and metrics only.
KEYCLOAK_HTTP_PORT=8180
KEYCLOAK_MANAGEMENT_PORT=9000
KEYCLOAK_HOSTNAME=http://localhost:8180
KEYCLOAK_ADMIN_USERNAME=local-admin
KEYCLOAK_ADMIN_PASSWORD=GENERATE_ME

# The BFF client and local test user are imported reproducibly. Their secrets are
# generated into .env and substituted by Keycloak during realm import.
KEYCLOAK_BFF_CLIENT_SECRET=GENERATE_ME
LOCAL_TEST_USER_USERNAME=local-user
LOCAL_TEST_USER_PASSWORD=GENERATE_ME
