{
  "realm": "videogame-platform",
  "displayName": "VideoGame Platform",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": true,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "loginWithEmailAllowed": false,
  "duplicateEmailsAllowed": false,
  "verifyEmail": false,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "clients": [
    {
      "clientId": "videogame-platform-bff",
      "name": "VideoGame Platform BFF",
      "description": "Confidential BFF client for the learning MVP.",
      "enabled": true,
      "protocol": "openid-connect",
      "clientAuthenticatorType": "client-secret",
      "secret": "${KEYCLOAK_BFF_CLIENT_SECRET}",
      "publicClient": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "authorizationServicesEnabled": false,
      "frontchannelLogout": true,
      "fullScopeAllowed": false,
      "rootUrl": "${APPLICATION_PUBLIC_ORIGIN}",
      "baseUrl": "/",
      "redirectUris": [
        "${APPLICATION_PUBLIC_ORIGIN}/login/oauth2/code/keycloak"
      ],
      "webOrigins": [
        "${APPLICATION_PUBLIC_ORIGIN}"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${APPLICATION_PUBLIC_ORIGIN}/",
        "oauth2.device.authorization.grant.enabled": "false",
        "backchannel.logout.session.required": "true",
        "backchannel.logout.revoke.offline.tokens": "false"
      }
    }
  ]
}
