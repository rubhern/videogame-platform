#!/usr/bin/env bash

set -Eeuo pipefail

usage() {
  printf 'Usage: %s <absolute-secrets-directory> <runtime-group>\n' "$0" >&2
}

if (($# != 2)); then
  usage
  exit 2
fi

if ((EUID != 0)); then
  printf 'Run this command as root so ownership and permissions are deterministic.\n' >&2
  exit 1
fi

secrets_directory="$(realpath -m -- "$1")"
runtime_group="$2"
repository_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)"

if [[ "$secrets_directory" != /* || "$secrets_directory" == / || "$secrets_directory" == /home || "$secrets_directory" == "$repository_root" || "$secrets_directory" == "$repository_root"/* ]]; then
  printf 'Refusing unsafe secrets directory: %s\n' "$secrets_directory" >&2
  exit 1
fi

getent group "$runtime_group" >/dev/null || {
  printf 'Runtime group does not exist: %s\n' "$runtime_group" >&2
  exit 1
}

umask 0027
install -d -m 0750 -o root -g "$runtime_group" -- "$secrets_directory"

create_random_secret() {
  local name="$1"
  local target="$secrets_directory/$name"
  local temporary
  if [[ -s "$target" ]]; then
    printf 'Preserved existing secret: %s\n' "$target"
    return
  fi
  if [[ -e "$target" && ! -f "$target" ]]; then
    printf 'Refusing non-file secret target: %s\n' "$target" >&2
    exit 1
  fi
  temporary="$(mktemp "$secrets_directory/.${name}.XXXXXX")"
  openssl rand -hex 32 >"$temporary"
  chown root:"$runtime_group" "$temporary"
  # The protected 0750 parent directory owns host access. Compose bind-mounts only
  # explicitly granted files; 0644 also lets images that drop supplementary groups
  # (notably PostgreSQL during initialization) read their in-container mount.
  chmod 0644 "$temporary"
  mv -- "$temporary" "$target"
  printf 'Created secret: %s\n' "$target"
}

create_literal_secret() {
  local name="$1"
  local value="$2"
  local target="$secrets_directory/$name"
  local temporary
  if [[ -s "$target" ]]; then
    printf 'Preserved existing secret: %s\n' "$target"
    return
  fi
  if [[ -e "$target" && ! -f "$target" ]]; then
    printf 'Refusing non-file secret target: %s\n' "$target" >&2
    exit 1
  fi
  temporary="$(mktemp "$secrets_directory/.${name}.XXXXXX")"
  printf '%s\n' "$value" >"$temporary"
  chown root:"$runtime_group" "$temporary"
  chmod 0644 "$temporary"
  mv -- "$temporary" "$target"
  printf 'Created secret: %s\n' "$target"
}

create_empty_optional_secret() {
  local name="$1"
  local target="$secrets_directory/$name"
  if [[ -e "$target" ]]; then
    printf 'Preserved existing optional secret: %s\n' "$target"
    return
  fi
  install -m 0644 -o root -g "$runtime_group" /dev/null "$target"
  printf 'Created disabled optional secret: %s\n' "$target"
}

for secret_name in \
  postgres-admin-password \
  application-db-password \
  application-migration-db-password \
  keycloak-db-password \
  keycloak-admin-password \
  keycloak-bff-client-secret; do
  create_random_secret "$secret_name"
done

create_empty_optional_secret igdb-client-id
create_empty_optional_secret igdb-client-secret
create_literal_secret oidc-smoke-username vgp-deployment-smoke
create_random_secret oidc-smoke-password

printf 'Secrets are ready in %s; values were not printed.\n' "$secrets_directory"
