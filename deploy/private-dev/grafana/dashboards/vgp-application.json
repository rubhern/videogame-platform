    {
      "title": "Successful 2xx / 3xx share",
      "type": "stat",
      "description": "HTTP success + conditional/cache redirects / all requests in the rate window.",
      "datasource": {
        "type": "prometheus",
        "uid": "private-dev-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "private-dev-prometheus"
          },
          "expr": "(sum (rate(http_server_requests_milliseconds_count{job=\"application-otlp\",uri=~\"$route\",method=~\"$method\",status=~\"2..|3..\"}[$__rate_interval]))) / ((sum (rate(http_server_requests_milliseconds_count{job=\"application-otlp\",uri=~\"$route\",method=~\"$method\"}[$__rate_interval]))) > 0)",
          "legendFormat": "",
          "editorMode": "code",
          "range": false,
          "instant": true
