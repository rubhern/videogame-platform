{
  "uid": "vgp-application",
  "title": "VideoGame Platform \u00b7 Application / HTTP",
  "description": "Product API traffic, HTTP outcomes, latency and stable errors. Expected unrated-game reads are separated. Counts estimate server calls, not visits or users.",
  "tags": [
    "videogame-platform",
    "private-dev"
  ],
  "schemaVersion": 39,
  "version": 2,
  "editable": false,
  "timezone": "Europe/Madrid",
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "1m",
      "5m",
      "15m"
    ]
  },
  "templating": {
    "list": [
      {
        "name": "route",
        "label": "Route",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "private-dev-prometheus"
        },
        "query": "label_values(http_server_requests_milliseconds_count{job=\"application-otlp\",uri=~\"/api/v1/.*\"}, uri)",
        "refresh": 1,
        "includeAll": true,
        "allValue": "/api/v1/.*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1,
        "options": []
      },
      {
        "name": "method",
        "label": "Method",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "private-dev-prometheus"
        },
        "query": "label_values(http_server_requests_milliseconds_count{job=\"application-otlp\",uri=~\"/api/v1/.*\"}, method)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1,
        "options": []
      }
    ]
  },
  "links": [
    {
      "title": "Resources",
      "url": "/d/vgp-runtime",
      "type": "link",
      "keepTime": false
    },
    {
      "title": "Application",
      "url": "/d/vgp-application",
      "type": "link",
      "keepTime": false
    },
    {
      "title": "Synchronization",
      "url": "/d/vgp-synchronization",
      "type": "link",
      "keepTime": false
    },
    {
      "title": "Product",
      "url": "/d/vgp-product",
      "type": "link",
      "keepTime": false
    }
  ],
  "panels": [
    {
      "id": 1,
      "title": "Selected range \u00b7 volume, status and actionable failures",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "title": "API requests \u00b7 range",
      "type": "stat",
      "description": "Estimated events in the selected range via increase(); resets handled where observed. The first event before a baseline export may be missed; fractional values reflect extrapolation.",
      "datasource": {
        "type": "prometheus",
        "uid": "private-dev-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "private-dev-prometheus"
          },
          "expr": "sum (increase(http_server_requests_milliseconds_count{job=\"application-otlp\",uri=~\"$route\",method=~\"$method\"}[$__range]))",
          "legendFormat": "",
          "editorMode": "code",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "auto",
        "orientation": "auto"
      },
      "id": 2,
      "gridPos": {
