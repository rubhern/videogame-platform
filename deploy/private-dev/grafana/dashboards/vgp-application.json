    {
      "title": "4xx / 5xx rejection rate",
      "type": "stat",
      "description": "Client rejections and server failures are diagnostic categories; the exact GET personal-rating 404 is excluded. No project SLO threshold.",
      "datasource": {
        "type": "prometheus",
        "uid": "private-dev-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "private-dev-prometheus"
          },
          "expr": "(sum (rate(http_server_requests_milliseconds_count{job=\"application-otlp\",uri=~\"$route\",method=~\"$method\",status=~\"4..|5..\"}[$__rate_interval]) unless rate(http_server_requests_milliseconds_count{job=\"application-otlp\",uri=\"/api/v1/me/ratings/{gameId}\",method=\"GET\",status=\"404\"}[$__rate_interval]))) / ((sum (rate(http_server_requests_milliseconds_count{job=\"application-otlp\",uri=~\"$route\",method=~\"$method\"}[$__rate_interval]))) > 0)",
          "legendFormat": "",
          "editorMode": "code",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
