      "description": "Actividad observada, incluidas pruebas; no es un registro orgánico ni histórico completo. Los reinicios, primeras muestras, huecos de recogida y retención limitan estas estimaciones. Los datos previos pueden seguir visibles si una fuente deja de responder.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "private-dev-prometheus"
          },
          "expr": "(sum(increase(keycloak_user_events_total{job=\"keycloak-product\",realm=\"videogame-platform\",event=\"register\",error=\"\"}[$__range]))) or ((max(up{job=\"keycloak-product\"}) == 1) * 0)",
