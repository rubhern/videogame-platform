        "h": 5
      },
      "description": "Availability of the identity metrics source; it does not confirm that the product registration journey works.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "private-dev-prometheus"
          },
          "expr": "max(up{job=\"keycloak-product\"})",
          "instant": true,
          "range": false,
          "legendFormat": "Identity metrics source"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "Not configured / no data",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Unreachable",
                  "color": "red"
                },
                "1": {
                  "text": "Available",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {}
