    {
      "id": 2,
      "title": "Registrations today",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "private-dev-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "description": "Estimated from observed activity, including tests; not organic sign-ups or a complete history. Restarts, first samples, collection gaps and retention limit these estimates. Earlier data can remain visible if a source stops responding.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "private-dev-prometheus"
          },
          "expr": "(sum(increase(keycloak_user_events_total{job=\"keycloak-product\",realm=\"videogame-platform\",event=\"register\",error=\"\"}[$__range]))) or ((max(up{job=\"keycloak-product\"}) == 1) * 0)",
          "instant": true,
          "range": false,
          "legendFormat": "Registrations"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {},
      "timeFrom": "now/d"
    },
