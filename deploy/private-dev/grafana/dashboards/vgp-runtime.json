{
  "uid": "vgp-runtime",
  "title": "VideoGame Platform \u00b7 Runtime / Resources",
  "description": "Resource pressure and telemetry delivery. No product HTTP metrics. Scrape availability is not application readiness; process metrics expire if OTLP stops.",
  "tags": [
    "videogame-platform",
    "private-dev"
  ],
  "schemaVersion": 39,
  "version": 2,
  "editable": false,
  "timezone": "Europe/Madrid",
  "refresh": "1m",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "1m",
      "5m",
      "15m"
    ]
  },
  "templating": {
    "list": []
  },
  "links": [
    {
      "title": "Resources",
      "url": "/d/vgp-runtime",
      "type": "link",
      "keepTime": false
    },
    {
      "title": "Application",
      "url": "/d/vgp-application",
      "type": "link",
      "keepTime": false
    },
    {
      "title": "Synchronization",
      "url": "/d/vgp-synchronization",
      "type": "link",
      "keepTime": false
    },
    {
      "title": "Product",
      "url": "/d/vgp-product",
      "type": "link",
      "keepTime": false
    }
  ],
  "panels": [
    {
      "id": 1,
      "title": "Now \u00b7 process and resource headroom",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "title": "Process uptime",
      "type": "stat",
      "description": "Time since this process started; absent during missing exports, not a liveness probe.",
      "datasource": {
        "type": "prometheus",
        "uid": "private-dev-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "private-dev-prometheus"
          },
          "expr": "process_uptime_seconds{job=\"application-otlp\"}",
          "legendFormat": "Process uptime",
          "editorMode": "code",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "auto",
        "orientation": "auto"
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      }
    },
    {
      "title": "Heap occupancy",
      "type": "gauge",
      "description": "Heap used / positive reported heap maximum; maximum is the meaningful capacity.",
      "datasource": {
        "type": "prometheus",
        "uid": "private-dev-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "private-dev-prometheus"
          },
          "expr": "(sum (jvm_memory_used_bytes{job=\"application-otlp\",area=\"heap\"})) / ((sum (jvm_memory_max_bytes{job=\"application-otlp\",area=\"heap\"} > 0)) > 0)",
          "legendFormat": "Heap occupancy",
          "editorMode": "code",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "No data",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "id": 3,
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 4
      }
    },
    {
      "title": "Pool occupancy",
      "type": "gauge",
      "description": "Active / configured Hikari maximum. One means every pool slot is occupied; inspect pending borrowers.",
      "datasource": {
        "type": "prometheus",
        "uid": "private-dev-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "private-dev-prometheus"
          },
          "expr": "(hikaricp_connections_active{job=\"application-otlp\"}) / ((hikaricp_connections_max{job=\"application-otlp\"}) > 0)",
          "legendFormat": "Pool occupancy",
          "editorMode": "code",
          "range": false,
          "instant": true
