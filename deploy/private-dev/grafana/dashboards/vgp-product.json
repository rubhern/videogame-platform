    {
      "title": "Detail reads by eligibility \u00b7 range",
      "type": "bargauge",
      "description": "Estimated events in the selected range via increase(); resets handled where observed. The first event before a baseline export may be missed; fractional values reflect extrapolation. Response eligibility categories count API reads, not distinct Games.",
      "datasource": {
        "type": "prometheus",
        "uid": "private-dev-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "private-dev-prometheus"
          },
          "expr": "sum by (eligibility) (increase(catalogue_game_details_total{job=\"application-otlp\"}[$__range]))",
