            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "ELIGIBLE_RELEASE_FOUND"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Eligible"
              }
            ]
          },
          {
