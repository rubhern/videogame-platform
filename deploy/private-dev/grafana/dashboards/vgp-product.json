    {
      "title": "Journey API activity",
      "type": "timeseries",
      "description": "Rate of server API calls by route and method. Backend caching does not imply navigation, visits or sessions.",
      "datasource": {
        "type": "prometheus",
        "uid": "private-dev-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "private-dev-prometheus"
          },
          "expr": "sum by (uri,method) (rate(http_server_requests_milliseconds_count{job=\"application-otlp\",uri=~\"/api/v1/.*\"}[$__rate_interval]))",
          "legendFormat": "{{method}} {{uri}}",
          "editorMode": "code",
          "range": true,
          "instant": false
