{
  "apiVersion": 1,
  "contactPoints": [
    __TELEGRAM_CONTACT_POINT__
    __TELEGRAM_PRODUCT_CONTACT_POINT__
  ],
  "templates": [{
    "orgId": 1,
    "name": "gameometro-telegram",
    "template": "{{ define \"gameometro.environment\" }}{{ if .CommonLabels.environment }}{{ .CommonLabels.environment }}{{ else }}private-dev{{ end }}{{ end }}{{ define \"gameometro.telegram\" }}Gameómetro — {{ if eq .Status \"firing\" }}Operational {{ if eq .CommonLabels.severity \"critical\" }}critical alert{{ else }}warning{{ end }}{{ else }}Operational alert closed{{ end }}\nSeverity: {{ if .CommonLabels.severity }}{{ .CommonLabels.severity }}{{ else }}unknown{{ end }}\nEnvironment: {{ template \"gameometro.environment\" . }}\n{{ if gt (len .Alerts) 4 }}Showing 4 of {{ len .Alerts }} alerts; see the full group in Grafana.\n{{ range (slice .Alerts 0 4) }}{{ template \"gameometro.alert\" . }}{{ end }}{{ else }}{{ range .Alerts }}{{ template \"gameometro.alert\" . }}{{ end }}{{ end }}\nAlert list: {{ reReplaceAll \"/$\" \"\" .ExternalURL }}/alerting/list{{ if .CommonAnnotations.runbook_url }}\nRunbook: {{ .CommonAnnotations.runbook_url }}{{ end }}{{ end }}{{ define \"gameometro.alert\" }}\n{{ if eq .Status \"firing\" }}Problem: {{ if .Annotations.summary }}{{ .Annotations.summary }}{{ else }}Rule evaluation error or missing data ({{ .Labels.alertname }}){{ end }}{{ if .Labels.outcome }} ({{ .Labels.outcome }}){{ end }}\nFirst action: {{ if .Annotations.action }}{{ .Annotations.action }}{{ else }}Check the data sources and the rule in Grafana; this does not confirm a service outage.{{ end }}\n{{ else if eq .Annotations.resolution_kind \"window_expiry\" }}Window expired: {{ .Annotations.summary }}{{ if .Labels.outcome }} ({{ .Labels.outcome }}){{ end }}\nThe failure window expired. This does NOT confirm a later successful run; check the latest run report.\n{{ else }}Recovered: {{ if .Annotations.summary }}{{ .Annotations.summary }}{{ else }}{{ .Labels.alertname }}{{ end }}\nThe alert condition is no longer met; confirm the service state.\n{{ end }}{{ if .DashboardURL }}Dashboard: {{ .DashboardURL }}\n{{ end }}{{ end }}"
  },{
    "orgId": 1,
    "name": "gameometro-telegram-product",
    "template": "{{ define \"gameometro.telegram.product\" }}{{ range .Alerts.Firing }}Gameómetro — New user registration{{ if ne .Annotations.observed_registrations \"1\" }}s{{ end }} detected\n{{ if .Annotations.observed_registrations }}New registrations observed: {{ .Annotations.observed_registrations }}{{ if ne .Annotations.observed_registrations \"1\" }} (estimate; registrations in one window are grouped and some can be missed){{ end }}{{ else }}New registration activity observed; count unavailable.{{ end }}\nEnvironment: {{ if .Labels.environment }}{{ .Labels.environment }}{{ else }}private-dev{{ end }}\nView in Grafana: {{ if .DashboardURL }}{{ .DashboardURL }}{{ else }}{{ reReplaceAll \"/$\" \"\" $.ExternalURL }}/d/vgp-growth{{ end }}\n{{ end }}{{ end }}"
  }],
  "muteTimes": [{"orgId":1,"name":"private-dev-ui-only","time_intervals":[{"times":[{"start_time":"00:00","end_time":"24:00"}]}]}],
  "policies": [{
    "orgId":1,
    "receiver":"empty",
    "group_by":["environment","service","category","severity"],
    "group_wait":"1m",
    "group_interval":"5m",
    "repeat_interval":"4h",
    "routes":[
      {"receiver":"__OPERATIONAL_RECEIVER__","object_matchers":[["category","=","operational"]],
       "mute_time_intervals":__OPERATIONAL_MUTE__},
      {"receiver":"__OPERATIONAL_RECEIVER__","object_matchers":[["alertname","=~","Datasource(Error|NoData)"]],
       "mute_time_intervals":__OPERATIONAL_MUTE__},
      {"receiver":"__PRODUCT_RECEIVER__","object_matchers":[["category","=","product"]],
       "group_by":["environment","service","category","alertname"],"repeat_interval":"24h",
       "mute_time_intervals":__PRODUCT_MUTE__}
    ]
  }]
}
