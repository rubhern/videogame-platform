#!/usr/bin/env python3
"""Unattended 30-day unverified-account cleanup on the production VPS (#539, ADR-0044).

`run` completes any incomplete erasure with `retry`, then runs `cleanup-unverified --execute`
until no eligible account remains or a bounded number of rounds pass. Both go through the
existing `personal-data-ledger`, the reviewed `recovery-personal-data --identity-cleanup`
transport and the `identity-maintenance` deny/drain fence, with the two-copy cloud ledger and
archive. No deletion logic lives here: this file validates its protected configuration,
resolves the active runtime, builds the reviewed command lines from its own source tree and
records a bounded status that host telemetry turns into an alert.

`check` is read-only: it validates the configuration, lists the ledger and probes whether an
eligible account exists, without entering maintenance.
"""
import argparse
import datetime as dt
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import re
import shlex
import subprocess
import sys

sys.dont_write_bytecode = True
HERE = Path(__file__).resolve().parent
ROOT = HERE.parents[2]
RECOVERY = HERE / 'recovery'
TRANSPORT = HERE / 'recovery-personal-data'
MAINTENANCE = HERE / 'identity-maintenance'
LEDGER = ROOT / 'deploy/private-dev/bin/personal-data-ledger'
FIELDS = {'admin', 'project', 'state', 's3Python', 'status', 'adminUsername', 'adminPasswordFile',
          'ledger', 'ledgerCopy', 'cloudCopies', 'archiveRoot', 'archiveCopy', 'proofRoot', 'holds',
          'gnupgHome', 'recipient', 'signer'}
# Every path the ledger writes stays under the admin directory, the only one the unit may write.
WRITTEN = ('ledger', 'ledgerCopy', 'archiveRoot', 'archiveCopy', 'proofRoot', 'gnupgHome')
# The recovery state directory belongs to the recovery actor, which checks it itself.
DIRECTORIES = ('admin', 'archiveRoot', 'archiveCopy', 'proofRoot', 'holds', 'gnupgHome')
FINGERPRINT = re.compile(r'[0-9A-F]{40}')
USERNAME = re.compile(r'[A-Za-z0-9][A-Za-z0-9._@-]{0,63}')
PROJECT = re.compile(r'[a-z0-9][a-z0-9-]{0,62}')
# Each round erases at most 100 accounts within the ledger's own two-minute fence budget.
MAX_ROUNDS = 5
# Seven steps at most (status, retry, five rounds) stay inside the unit's two-hour budget.
STEP_SECONDS = 900
OBSERVABILITY = Path('/etc/gameometro/production/observability')
REASONS = ('configuration', 'ledger-unavailable', 'retry-failed', 'cleanup-failed', 'unexpected-answer', 'timeout')


def load_core():
    loader = importlib.machinery.SourceFileLoader('unverified_cleanup_recovery', str(RECOVERY))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


core = load_core()
require = core.require
Refused = core.Refused


def inside(path, parent):
    return path == parent or parent in path.parents


def load_configuration(path):
    core.private(path)
    require(path.stat().st_size <= 16384, 'Oversized cleanup configuration.')
    config = json.loads(path.read_text())
    require(isinstance(config, dict) and set(config) == FIELDS, 'Cleanup configuration fields differ from the reviewed set.')
    require(all(isinstance(config[k], str) for k in FIELDS), 'Cleanup configuration values must be strings.')
    require(PROJECT.fullmatch(config['project']) is not None, 'Invalid Compose project name.')
    require(USERNAME.fullmatch(config['adminUsername']) is not None, 'Invalid identity operator name.')
    require(all(FINGERPRINT.fullmatch(config[k]) for k in ('recipient', 'signer')),
            'Recipient and signer must be full uppercase fingerprints.')
    paths = {k: Path(config[k]) for k in FIELDS
             if k not in ('project', 'adminUsername', 'recipient', 'signer')}
    require(all(p.is_absolute() and '..' not in p.parts for p in paths.values()), 'Cleanup paths must be absolute.')
    admin = paths['admin']
    require(all(inside(paths[k], admin) for k in WRITTEN), 'Ledger, archive, proof and keyring must live under the admin directory.')
    require(inside(paths['status'], OBSERVABILITY) or inside(paths['status'], admin),
            'The status file belongs with the other telemetry evidence.')
    require(paths['ledger'] != paths['ledgerCopy'] and paths['archiveRoot'] != paths['archiveCopy'],
            'Ledger and archive need two distinct local copies.')
    require(not any(inside(paths['proofRoot'], paths[k]) or inside(paths[k], paths['proofRoot'])
                    for k in ('archiveRoot', 'archiveCopy')), 'The suppression proof needs its own store.')
    for name in DIRECTORIES:
        core.private(paths[name], directory=True)
    for name in ('adminPasswordFile', 'cloudCopies'):
        core.private(paths[name])
    require(paths['state'].is_dir() and not paths['state'].is_symlink(), 'The recovery state directory is missing.')
    require(paths['s3Python'].is_file() and os.access(paths['s3Python'], os.X_OK), 'The S3 interpreter is missing.')
    for name in ('ledger', 'ledgerCopy'):
        core.private(paths[name].parent, directory=True)
    return config


def runtime_configuration(config):
    """The rendered Compose file of the active release, exactly as the backup cycle resolves it."""
    admin = Path(config['admin'])
    pointer = admin / 'upgrades/ACTIVE.json'
    if pointer.exists():
        active = json.loads(pointer.read_text())
        path = Path(active['configurationFile'])
        require(core.digest(path) == active['configurationSha256'], 'The active upgrade configuration changed.')
        return path
    return admin / 'compose.accepted.json'


def commands(config):
    compose = runtime_configuration(config)
    common = ['--config', str(compose), '--project', config['project'], '--state', config['state']]
    host = shlex.join([sys.executable, '-I', str(TRANSPORT), *common, '--admin-username', config['adminUsername'],
                       '--admin-password-file', config['adminPasswordFile'], '--identity-cleanup'])
    fence = shlex.join([sys.executable, '-I', str(MAINTENANCE), *common])
    ledger = [config['s3Python'], '-I', str(LEDGER), '--ledger', config['ledger'], '--ledger-copy', config['ledgerCopy'],
              '--cloud-copies', config['cloudCopies'], '--archive-root', config['archiveRoot'],
              '--archive-copy', config['archiveCopy'], '--proof-root', config['proofRoot'], '--holds', config['holds'],
              '--gnupg-home', config['gnupgHome'], '--recipient', config['recipient'], '--signer', config['signer'],
              '--host-command', host]
    return ledger, fence


def ledger_run(arguments):
    """Ledger output is identifiers and counts only; its fixed failure line goes to the root-only journal."""
    try:
        result = subprocess.run(arguments, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, timeout=STEP_SECONDS)
    except subprocess.TimeoutExpired:
        # A killed run can leave its identity fence closed: that is an owner incident (see README).
        return None, ''
    return result.returncode, result.stdout.decode(errors='replace')


def failure(code, reason):
    return 'timeout' if code is None else reason


def incomplete(listing):
    return sum(1 for line in listing.splitlines() if line.split('\t')[2:3] == ['INCOMPLETE'])


def last_json(text):
    for line in reversed(text.splitlines()):
        line = line.strip()
        if line.startswith('{'):
            value = json.loads(line)
            require(isinstance(value, dict), 'Unexpected cleanup answer.')
            return value
    raise Refused('Unexpected cleanup answer.')


def previous_success(path):
    try:
        return json.loads(path.read_text()).get('lastSuccessAt')
    except (OSError, ValueError, AttributeError):
        return None


def record(path, outcome, now, **fields):
    reason = fields.pop('reason', None)
    require(reason is None or reason in REASONS, 'Unknown cleanup failure reason.')
    status = {'kind': 'unverified-cleanup', 'outcome': outcome, 'finishedAt': now.isoformat().replace('+00:00', 'Z'),
              'attention': outcome != 'success', 'lastSuccessAt': previous_success(path), **fields}
    if reason:
        status['reason'] = reason
    if outcome == 'success':
        status['lastSuccessAt'] = status['finishedAt']
    path.parent.mkdir(parents=True, exist_ok=True)
    core.write(path, status)
    # Telemetry reads it as root-owned evidence that no other account may change.
    os.chmod(path, 0o644)
    return status


def run(config_path, now=None):
    now = now or core.utc()
    try:
        config = load_configuration(config_path)
    except (Refused, OSError, ValueError):
        print('Cleanup configuration refused; nothing ran.', file=sys.stderr)
        return 1
    status = Path(config['status'])
    try:
        ledger, fence = commands(config)
    except (Refused, OSError, ValueError, KeyError):
        record(status, 'failure', now, reason='configuration')
        return 1
    code, listing = ledger_run([*ledger, 'status'])
    if code != 0:
        record(status, 'failure', now, reason=failure(code, 'ledger-unavailable'))
        return 1
    retried = incomplete(listing)
    if retried:
        # Never admit a new cleanup over a pending one: the ledger refuses it, and retry finishes it.
        code, _ = ledger_run([*ledger, 'retry', '--maintenance-command', fence])
        if code != 0:
            record(status, 'failure', now, reason=failure(code, 'retry-failed'), retried=retried)
            return 1
    erased = skipped = 0
    backlog = False
    for _ in range(MAX_ROUNDS):
        code, output = ledger_run([*ledger, 'cleanup-unverified', '--execute', '--maintenance-command', fence])
        if code != 0:
            record(status, 'failure', now, reason=failure(code, 'cleanup-failed'), retried=retried, erased=erased)
            return 1
        try:
            answer = last_json(output)
        except (Refused, ValueError):
            record(status, 'failure', now, reason='unexpected-answer', retried=retried, erased=erased)
            return 1
        erased += int(answer.get('erased', 0))
        skipped += int(answer.get('skipped', 0))
        backlog = answer.get('backlog') is True
        # A round that erased nothing is not repeated: what remains is held or no longer eligible.
        if not backlog or not answer.get('erased'):
            break
    record(status, 'success', now, retried=retried, erased=erased, skipped=skipped, backlog=backlog)
    print(json.dumps({'retried': retried, 'erased': erased, 'skipped': skipped, 'backlog': backlog}))
    return 0


def check(config_path):
    config = load_configuration(config_path)
    ledger, _ = commands(config)
    code, listing = ledger_run([*ledger, 'status'])
    require(code == 0, 'The local ledger is unreadable; run ledger-fetch from its cloud copies first.')
    code, output = ledger_run([*ledger, 'cleanup-unverified'])
    require(code == 0, 'The read-only candidate probe failed.')
    probe = last_json(output)
    print(json.dumps({'configuration': 'ok', 'ledgerEntries': len(listing.splitlines()),
                      'incomplete': incomplete(listing),
                      'candidatesPresent': bool(probe.get('candidatesPresent') or probe.get('candidates'))}))
    return 0


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('command', choices=['run', 'check'])
    parser.add_argument('--config', type=Path, required=True)
    arguments = parser.parse_args()
    if arguments.command == 'run':
        return run(arguments.config)
    try:
        return check(arguments.config)
    except (Refused, OSError, ValueError) as error:
        print(str(error) if isinstance(error, Refused) else 'Cleanup check failed.', file=sys.stderr)
        return 1


if __name__ == '__main__':
    raise SystemExit(main())
