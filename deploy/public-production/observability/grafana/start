#!/bin/sh
set -eu
umask 077
mkdir -p /tmp/production-dashboards /tmp/grafana-provisioning/alerting /tmp/grafana-provisioning/dashboards
# Same canonical JSON; the one literal realm selector is an environment input.
for source in /etc/grafana/canonical-dashboards/*.json; do
  sed 's/realm=\\"videogame-platform\\"/realm=\\"gameometro\\"/g' "$source" > "/tmp/production-dashboards/${source##*/}"
done
cp /etc/grafana/production/capacity.json /tmp/production-dashboards/
/bin/sh /etc/grafana/provision-notifications
sed -e 's/"environment": "private-dev"/"environment": "production"/g' \
    -e 's/Platform logs/bounded Docker diagnostics/g' -e 's/#private-dev-alerts/#production-monitoring/g' \
    /etc/grafana/canonical-alerts.json > /tmp/grafana-provisioning/alerting/shared.json
cp /etc/grafana/production/alerts.json /tmp/grafana-provisioning/alerting/production.json
cp /etc/grafana/production/dashboards.yaml /tmp/grafana-provisioning/dashboards/production.yaml
# The shared launcher reads only this environment's secret files and enforces delivery off.
# It renders the notification policy again, preserving the files above.
exec /bin/sh /etc/grafana/start
