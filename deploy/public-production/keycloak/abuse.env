# Secret-free Keycloak runtime policy. #275 must consume this after building event metrics.
# Initial qualification bounds; these are NOT request-rate or email quotas.
KC_HTTP_POOL_MAX_THREADS=8
KC_HTTP_MAX_QUEUED_REQUESTS=16
KC_DB_POOL_INITIAL_SIZE=1
KC_DB_POOL_MIN_SIZE=1
KC_DB_POOL_MAX_SIZE=5
KC_EVENT_METRICS_USER_EVENTS=login,register,verify_email,send_verify_email,send_reset_password,reset_password,user_disabled_by_temporary_lockout
KC_EVENT_METRICS_USER_TAGS=realm
# Info logging, except the session-logout warnings that name the account: with the email as
# username they would write an erased address to the logs.
KC_LOG_LEVEL=info,org.keycloak.services.managers.AuthenticationManager:error
