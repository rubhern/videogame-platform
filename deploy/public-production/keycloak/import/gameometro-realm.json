{
  "realm": "gameometro",
  "displayName": "Gameómetro",
  "enabled": true,
  "sslRequired": "all",
  "loginTheme": "gameometro",
  "emailTheme": "gameometro",
  "internationalizationEnabled": true,
  "supportedLocales": [
    "es"
  ],
  "defaultLocale": "es",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "editUsernameAllowed": false,
  "verifyEmail": true,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "passwordPolicy": "length(12) and maxLength(128) and notEmail and notContainsUsername",
  "bruteForceProtected": true,
  "bruteForceStrategy": "MULTIPLE",
  "permanentLockout": false,
  "maxTemporaryLockouts": 0,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,
  "quickLoginCheckMilliSeconds": 1000,
  "minimumQuickLoginWaitSeconds": 60,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 28800,
  "ssoSessionIdleTimeoutRememberMe": 604800,
  "ssoSessionMaxLifespanRememberMe": 2592000,
  "clientSessionIdleTimeout": 0,
  "clientSessionMaxLifespan": 0,
  "offlineSessionIdleTimeout": 1800,
  "offlineSessionMaxLifespanEnabled": true,
  "offlineSessionMaxLifespan": 28800,
  "accessTokenLifespan": 300,
  "accessCodeLifespan": 60,
  "accessCodeLifespanLogin": 1800,
  "accessCodeLifespanUserAction": 300,
  "actionTokenGeneratedByUserLifespan": 300,
  "actionTokenGeneratedByAdminLifespan": 43200,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "eventsEnabled": false,
  "eventsListeners": [],
  "enabledEventTypes": [],
  "adminEventsEnabled": false,
  "adminEventsDetailsEnabled": false,
  "smtpServer": {
    "host": "${KEYCLOAK_SMTP_HOST}",
    "port": "${KEYCLOAK_SMTP_PORT}",
    "from": "${KEYCLOAK_SMTP_FROM}",
    "fromDisplayName": "Gameómetro",
    "auth": "true",
    "user": "${KEYCLOAK_SMTP_USER}",
    "password": "${KEYCLOAK_SMTP_PASSWORD}",
    "ssl": "false",
    "starttls": "true"
  },
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\":[{\"name\":\"username\",\"displayName\":\"${username}\",\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"validations\":{\"length\":{\"min\":3,\"max\":255},\"username-prohibited-characters\":{},\"up-username-not-idn-homograph\":{}}},{\"name\":\"email\",\"displayName\":\"${email}\",\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"validations\":{\"email\":{},\"length\":{\"max\":255}}}]}"
          ]
        }
      }
    ]
  },
  "registrationFlow": "gameometro registration",
  "authenticationFlows": [
    {
      "alias": "gameometro registration",
      "description": "Self-registration with the mandatory adult and terms declaration",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "registration-page-form",
          "authenticatorFlow": true,
          "flowAlias": "gameometro registration form",
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "gameometro registration form",
      "description": "Email, password and declaration; no other personal data",
      "providerId": "form-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "registration-user-creation",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false
        },
        {
          "authenticator": "registration-password-action",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 50,
          "userSetupAllowed": false
        },
        {
          "authenticator": "registration-terms-and-conditions",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 70,
          "userSetupAllowed": false
        }
      ]
    }
  ],
  "roles": {
    "client": {
      "videogame-platform-bff": [
        {
          "name": "catalogue-operator",
          "description": "Reads catalogue synchronization status and coverage in the catalogue administration view.",
          "composite": false,
          "clientRole": true
        }
      ]
    }
  },
  "clients": [
    {
      "clientId": "videogame-platform-bff",
      "name": "Gameómetro BFF",
      "description": "Confidential same-origin BFF client for public production.",
      "enabled": true,
      "protocol": "openid-connect",
      "clientAuthenticatorType": "client-secret",
      "secret": "${KEYCLOAK_BFF_CLIENT_SECRET}",
      "publicClient": false,
      "bearerOnly": false,
      "consentRequired": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "authorizationServicesEnabled": false,
      "frontchannelLogout": false,
      "fullScopeAllowed": false,
      "rootUrl": "https://${APPLICATION_PUBLIC_HOST}",
      "baseUrl": "/",
      "redirectUris": [
        "https://${APPLICATION_PUBLIC_HOST}/login/oauth2/code/keycloak"
      ],
      "webOrigins": [],
      "defaultClientScopes": [
        "basic"
      ],
      "optionalClientScopes": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://${APPLICATION_PUBLIC_HOST}/",
        "oauth2.device.authorization.grant.enabled": "false",
        "oidc.ciba.grant.enabled": "false",
        "standard.token.exchange.enabled": "false"
      },
      "protocolMappers": [
        {
          "name": "product roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "consentRequired": false,
          "config": {
            "usermodel.clientRoleMapping.clientId": "videogame-platform-bff",
            "claim.name": "product_roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "false",
            "lightweight.claim": "false"
          }
        },
        {
          "name": "native remember me",
          "protocol": "openid-connect",
          "protocolMapper": "gameometro-remember-me",
          "consentRequired": false,
          "config": {}
        }
      ]
    }
  ],
  "localizationTexts": {
    "es": {
      "termsTitle": "Antes de crear tu cuenta",
      "termsText": "<p>Responsable: Rubén Hernández López. Trataremos tu email, los datos necesarios para proteger tu cuenta y tus puntuaciones para prestarte el servicio que solicitas. La gestión de cuenta y puntuaciones se basa en la ejecución de las condiciones de uso; la seguridad, en nuestro interés legítimo, según se explica en la política de privacidad. Puedes ejercer tus derechos en <a href=\"mailto:hola@gameometro.com\">hola@gameometro.com</a>. Consulta la política de privacidad para conocer destinatarios, conservación, transferencias y todos tus derechos.</p><p>Para prestar el servicio utilizamos proveedores externos de alojamiento y correo. Las imágenes pueden cargarse desde un servicio externo. Algunos tratamientos pueden implicar transferencias internacionales, detalladas en la política de privacidad.</p><p>Crear una cuenta requiere tener al menos 18 años y aceptar las condiciones de uso. La información de privacidad se facilita para que conozcas el tratamiento; no te pedimos que consientas tratamientos opcionales para utilizar tu cuenta.</p><p>Consulta la <a href=\"https://${APPLICATION_PUBLIC_HOST}/privacidad\">política de privacidad</a> y las <a href=\"https://${APPLICATION_PUBLIC_HOST}/condiciones\">condiciones de uso</a> antes de registrarte.</p>",
      "acceptTerms": "Declaro que tengo 18 años o más y acepto las condiciones de uso de Gameómetro.",
      "termsAcceptanceRequired": "Para crear tu cuenta, confirma que tienes 18 años o más y aceptas las condiciones de uso.",
      "emailInstruction": "Indica tu email. Si corresponde a una cuenta, te enviaremos un enlace para crear una nueva contraseña.",
      "emailSentMessage": "Si el email corresponde a una cuenta, recibirás en breve un enlace para crear una nueva contraseña.",
      "invalidPasswordNotContainsUsernameMessage": "La contraseña no puede contener tu email.",
      "missingUsernameMessage": "Indica tu email.",
      "invalidUserMessage": "Email o contraseña incorrectos.",
      "accountTemporarilyDisabledMessage": "Email o contraseña incorrectos."
    }
  }
}
