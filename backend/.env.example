# Local backend application configuration reference. The local dependency wrapper
# creates an ignored .env beside this file and copies the shared generated secrets.
# Never commit backend/.env or replace these placeholders with usable credentials.

# Spring runtime. OIDC remains opt-in; set SPRING_PROFILES_ACTIVE=oidc to exercise
# the local Keycloak-backed BFF session, or structured for ECS JSON console logs.
SPRING_PROFILES_ACTIVE=
SERVER_PORT=8080
MANAGEMENT_SERVER_ADDRESS=127.0.0.1
MANAGEMENT_SERVER_PORT=8081
LOGGING_LEVEL_COM_VIDEOGAMEPLATFORM=INFO

# PostgreSQL runtime and explicit Flyway migration connection. Local startup keeps
# migration execution opt-in and excludes the disposable demonstration seed.
APPLICATION_DB_URL=jdbc:postgresql://localhost:5432/videogame_platform
APPLICATION_DB_USERNAME=videogame_app
APPLICATION_DB_PASSWORD=GENERATE_ME
APPLICATION_DB_CONNECTION_TIMEOUT=3000
APPLICATION_DB_VALIDATION_TIMEOUT=1000
APPLICATION_DB_MAXIMUM_POOL_SIZE=10
APPLICATION_CATALOGUE_READINESS_TIMEOUT=2s
APPLICATION_FLYWAY_ENABLED=false
APPLICATION_MIGRATION_DB_URL=jdbc:postgresql://localhost:5432/videogame_platform
APPLICATION_MIGRATION_DB_USERNAME=videogame_app_migrator
APPLICATION_MIGRATION_DB_PASSWORD=GENERATE_ME
SPRING_FLYWAY_LOCATIONS=classpath:db/migration

# OIDC-enabled application defaults for the supported plain-HTTP loopback proof.
# Remote HTTPS must use the approved __Host- cookie name and Secure=true.
KEYCLOAK_BFF_CLIENT_SECRET=GENERATE_ME
OIDC_ISSUER_URI=http://localhost:8180/realms/videogame-platform
APPLICATION_SESSION_TIMEOUT=30m
APPLICATION_SESSION_COOKIE_NAME=vgp_session
APPLICATION_SESSION_COOKIE_SECURE=false

# Catalogue JDBC bound, release and search policy, and public HTTP caching.
CATALOGUE_JDBC_READ_TIMEOUT=5s
CATALOGUE_RELEASES_RECENT_WINDOW_MONTHS=6
CATALOGUE_RELEASES_UPCOMING_WINDOW_MONTHS=6
CATALOGUE_RELEASES_FRESHNESS_THRESHOLD=P7D
CATALOGUE_RELEASES_CACHE_CONTROL="public, max-age=60, stale-while-revalidate=300"
CATALOGUE_SEARCH_RELEASE_CONTEXT_LIMIT=3
CATALOGUE_SEARCH_CACHE_CONTROL="public, max-age=60, stale-while-revalidate=300"

# OpenTelemetry-compatible export remains disabled until an explicit local
# collector is available. Endpoints are loopback-only development defaults.
TELEMETRY_OTLP_TRACES_ENABLED=false
TELEMETRY_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
TELEMETRY_OTLP_METRICS_ENABLED=false
TELEMETRY_OTLP_METRICS_ENDPOINT=http://localhost:4318/v1/metrics
TELEMETRY_OTLP_METRICS_STEP=60s
TELEMETRY_TRACING_SAMPLING_PROBABILITY=1.0
