{
  "info": {
    "_postman_id": "8403481b-23f0-42ba-a97b-1c47ae012f32",
    "name": "VideoGame Platform Backend - Catalogue Releases",
    "description": "Executable examples for the OpenAPI 3.0.0 GET /api/v1/releases contract implemented through the Maven-generated ReleasesApi interface and a bounded PostgreSQL page query grouped by game. Each item is one game with its matching releases, and pagination counts games. Run against a disposable local database initialized with the tracked development seed; no provider credential or request-path provider call is required.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "releaseEtag",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Recent releases",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response follows the reviewed release-page contract\", function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.view).to.eql(\"recent\");",
              "    pm.expect(body).to.have.all.keys(\"view\", \"evaluatedOn\", \"window\", \"activeFilters\", \"availableFilters\", \"items\", \"page\");",
              "    pm.expect((Date.parse(body.window.to) - Date.parse(body.window.from)) / 86400000).to.eql(6);",
              "    pm.expect(body.page.number).to.eql(1);",
              "    pm.expect(body.page.size).to.eql(20);",
              "    pm.expect(body.page.totalItems).to.be.a(\"number\").and.at.least(0);",
              "    pm.expect(body.page.totalPages).to.be.a(\"number\").and.at.least(0);",
              "    body.items.forEach(function (item) {",
              "        pm.expect(item).to.include.all.keys(\"gameId\", \"slug\", \"canonicalTitle\", \"primaryCover\", \"releases\");",
              "        pm.expect(item.releases).to.be.an(\"array\").and.not.empty;",
              "        item.releases.forEach(function (release) {",
              "            pm.expect(release).to.include.all.keys(\"releaseId\", \"gameId\", \"releaseDate\", \"provenance\", \"lastSyncedAt\", \"verificationLevel\", \"reviewStatus\", \"freshnessStatus\");",
              "            pm.expect(release.gameId).to.eql(item.gameId);",
              "            pm.expect([\"day\", \"month\", \"quarter\", \"year\", \"unknown\"]).to.include(release.releaseDate.precision);",
              "            pm.expect([\"fresh\", \"stale\"]).to.include(release.freshnessStatus);",
              "        });",
              "    });",
              "});",
              "",
              "pm.test(\"Public cache and correlation headers are present\", function () {",
              "    pm.expect(pm.response.headers.get(\"X-Correlation-ID\")).to.be.a(\"string\").and.not.empty;",
              "    pm.expect(pm.response.headers.get(\"Cache-Control\")).to.include(\"public\");",
              "    pm.expect(pm.response.headers.get(\"ETag\")).to.match(/^\"[0-9a-f]{64}\"$/);",
              "});",
              "",
              "pm.test(\"Each game presents at most one release per platform\", function () {",
              "    pm.response.json().items.forEach(function (item) {",
              "        const platforms = item.releases.map(function (release) { return release.platform.platformId; });",
              "        pm.expect(new Set(platforms).size).to.eql(platforms.length);",
              "    });",
              "});",
              "",
              "pm.collectionVariables.set(\"releaseEtag\", pm.response.headers.get(\"ETag\"));",
              "pm.test(\"Product release stages\", () => { const body = pm.response.json(); const releases = body.releases || (body.items || []).flatMap(item => item.releases || []); releases.forEach(r => pm.expect([\"full_release\", \"early_access\", \"advance_access\", \"beta\", \"alpha\", \"unknown\"]).to.include(r.stage)); });",
              "pm.test(\"Compact localized genres only\", () => { if (pm.response.code !== 200) return; const payload = pm.response.json(); payload.items.forEach(item => { const game = item.game || item; pm.expect(game.genres).to.be.an(\"array\"); pm.expect(game.genres.length).to.be.at.most(2); game.genres.forEach(term => { pm.expect(term.genreId).to.be.a(\"string\"); pm.expect(term.name).to.be.a(\"string\"); }); [\"summary\", \"developers\", \"publishers\", \"gameModes\"].forEach(field => pm.expect(game).not.to.have.property(field)); }); });"
            ],
            "type": "text/javascript",
            "packages": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/releases?view=recent&page=1&pageSize=20",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "releases"
          ],
          "query": [
            {
              "key": "view",
              "value": "recent"
            },
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "pageSize",
              "value": "20"
            }
          ]
        },
        "description": "Returns one bounded page from the current local publication. PostgreSQL filters, counts, orders and pages; ordering ends with unique releaseId."
      },
      "response": []
    },
