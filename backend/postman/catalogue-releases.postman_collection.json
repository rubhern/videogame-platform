    {
      "name": "Upcoming releases filtered by platform and region",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Multi-select filters combine OR within a dimension and AND across dimensions\", function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.view).to.eql(\"upcoming\");",
              "    pm.expect((Date.parse(body.window.to) - Date.parse(body.window.from)) / 86400000).to.eql(14);",
              "    pm.expect(body.activeFilters.platformIds).to.include.members([\"10000000-0000-4000-8000-000000000004\", \"10000000-0000-4000-8000-000000000001\"]);",
              "    pm.expect(body.activeFilters.regionIds).to.include.members([\"20000000-0000-4000-8000-000000000001\"]);",
              "    pm.expect(body.availableFilters.platforms).to.be.an(\"array\").and.not.empty;",
              "    pm.expect(body.availableFilters.regions).to.be.an(\"array\").and.not.empty;",
              "});",
              "",
              "pm.test(\"Region options carry catalogue-owned labels for their stable IDs\", function () {",
              "    const regions = pm.response.json().availableFilters.regions;",
              "    const worldwide = regions.find(region => region.regionId === \"20000000-0000-4000-8000-000000000001\");",
              "    pm.expect(worldwide.name).to.eql(\"Mundial\");",
              "    regions.forEach(region => pm.expect(region.name).not.to.include(\"_\"));",
              "});",
              "pm.test(\"Compact localized genres only\", () => { if (pm.response.code !== 200) return; const payload = pm.response.json(); payload.items.forEach(item => { const game = item.game || item; pm.expect(game.genres).to.be.an(\"array\"); pm.expect(game.genres.length).to.be.at.most(2); game.genres.forEach(term => { pm.expect(term.genreId).to.be.a(\"string\"); pm.expect(term.name).to.be.a(\"string\"); }); [\"summary\", \"developers\", \"publishers\", \"gameModes\"].forEach(field => pm.expect(game).not.to.have.property(field)); }); });"
            ],
            "type": "text/javascript",
            "packages": {}
          }
        }
