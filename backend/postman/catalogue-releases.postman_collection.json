    {
      "name": "Upcoming releases including approximate dates",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Approximate dates keep their real precision and follow exact days\", function () {",
              "    const body = pm.response.json();",
              "    const releases = body.items.flatMap(function (item) { return item.releases; });",
              "    const approximate = releases.filter(function (release) { return release.releaseDate.precision !== \"day\"; });",
              "    // The deterministic seed always holds one TBA upcoming release, whatever the date.",
              "    pm.expect(approximate.map(function (release) { return release.releaseDate.precision; })).to.include(\"unknown\");",
              "    approximate.forEach(function (release) {",
              "        if (release.releaseDate.precision === \"unknown\") {",
              "            pm.expect(release.releaseDate.value).to.eql(null);",
              "        } else {",
              "            pm.expect(release.releaseDate.value).to.match(/^[0-9]{4}(-(0[1-9]|1[0-2]|Q[1-4]))?$/);",
              "        }",
              "    });",
              "    const firstGamePrecisions = body.items.map(function (item) { return item.releases[0].releaseDate.precision; });",
              "    const firstApproximate = firstGamePrecisions.findIndex(function (precision) { return precision !== \"day\"; });",
              "    if (firstApproximate >= 0) {",
              "        pm.expect(firstGamePrecisions.slice(firstApproximate)).to.not.include(\"day\");",
              "    }",
              "});",
              "",
              "pm.test(\"Each game presents at most one release per platform\", function () {",
              "    pm.response.json().items.forEach(function (item) {",
              "        const platforms = item.releases.map(function (release) { return release.platform.platformId; });",
              "        pm.expect(new Set(platforms).size).to.eql(platforms.length);",
              "    });",
              "});",
              "pm.test(\"Compact localized genres only\", () => { if (pm.response.code !== 200) return; const payload = pm.response.json(); payload.items.forEach(item => { const game = item.game || item; pm.expect(game.genres).to.be.an(\"array\"); pm.expect(game.genres.length).to.be.at.most(2); game.genres.forEach(term => { pm.expect(term.genreId).to.be.a(\"string\"); pm.expect(term.name).to.be.a(\"string\"); }); [\"summary\", \"developers\", \"publishers\", \"gameModes\"].forEach(field => pm.expect(game).not.to.have.property(field)); }); });"
            ],
            "type": "text/javascript",
            "packages": {}
          }
        }
