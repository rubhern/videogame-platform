{
  "info": {
    "name": "Private Wishlist",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Disposable signed-in account only. Saves then removes one seeded game."
  },
  "variable": [
    {
      "key": "wishlistGameId",
      "value": "30000000-0000-4000-8000-000000000005"
    },
    {
      "key": "otherWishlistGameId",
      "value": "30000000-0000-4000-8000-000000000001"
    },
    {
      "key": "csrfToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Read signed-in session and CSRF proof",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/session"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Private response is never stored\", () => pm.expect(pm.response.headers.get(\"Cache-Control\")).to.eql(\"no-store\"));",
              "pm.test(\"Authenticated session\", () => pm.expect(pm.response.json().authenticated).to.eql(true));",
              "pm.collectionVariables.set(\"csrfToken\", pm.response.json().csrfToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "Reject a wish without CSRF",
      "request": {
        "method": "PUT",
        "header": [],
        "url": "{{baseUrl}}/api/v1/me/wishlist/games/{{wishlistGameId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 403\", () => pm.response.to.have.status(403));",
              "pm.test(\"Private response is never stored\", () => pm.expect(pm.response.headers.get(\"Cache-Control\")).to.eql(\"no-store\"));",
              "pm.test(\"Stable CSRF problem\", () => pm.expect(pm.response.json().code).to.eql(\"CSRF_VALIDATION_FAILED\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Save a game",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "X-CSRF-Token",
            "value": "{{csrfToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/me/wishlist/games/{{wishlistGameId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 204\", () => pm.response.to.have.status(204));",
              "pm.test(\"Private response is never stored\", () => pm.expect(pm.response.headers.get(\"Cache-Control\")).to.eql(\"no-store\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Repeat the same wish",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "X-CSRF-Token",
            "value": "{{csrfToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/me/wishlist/games/{{wishlistGameId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 204\", () => pm.response.to.have.status(204));",
              "pm.test(\"Private response is never stored\", () => pm.expect(pm.response.headers.get(\"Cache-Control\")).to.eql(\"no-store\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Read saved IDs for a bounded set",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/me/wishlist/status?gameIds={{wishlistGameId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Private response is never stored\", () => pm.expect(pm.response.headers.get(\"Cache-Control\")).to.eql(\"no-store\"));",
              "pm.test(\"Game is saved\", () => pm.expect(pm.response.json().gameIds).to.eql([pm.collectionVariables.get(\"wishlistGameId\")]));"
            ]
          }
        }
      ]
    },
    {
      "name": "Keep a saved game in place when it is its own anchor",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "X-CSRF-Token",
            "value": "{{csrfToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/me/wishlist/games/{{wishlistGameId}}/position",
        "body": {
          "mode": "raw",
          "raw": "{\"anchorGameId\":\"{{wishlistGameId}}\",\"placement\":\"before\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Priority saved privately\", () => { pm.response.to.have.status(204); pm.expect(pm.response.headers.get(\"Cache-Control\")).to.eql(\"no-store\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Read the first wishlist page",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/me/wishlist?page=1&pageSize=1"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Private response is never stored\", () => pm.expect(pm.response.headers.get(\"Cache-Control\")).to.eql(\"no-store\"));",
              "pm.test(\"One unique game\", () => pm.expect(pm.response.json().page.totalItems).to.eql(1));",
              "pm.test(\"Expected game and precision\", () => { const game = pm.response.json().items[0]; pm.expect(game.gameId).to.eql(pm.collectionVariables.get(\"wishlistGameId\")); pm.expect(game.releaseDate.precision).to.eql(\"day\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Save a second game",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "X-CSRF-Token",
            "value": "{{csrfToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/me/wishlist/games/{{otherWishlistGameId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 204\", () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "Move the second game before the first",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "X-CSRF-Token",
            "value": "{{csrfToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/me/wishlist/games/{{otherWishlistGameId}}/position",
        "body": {
          "mode": "raw",
          "raw": "{\"anchorGameId\":\"{{wishlistGameId}}\",\"placement\":\"before\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 204\", () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "Read the saved positions",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/me/wishlist?pageSize=2"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"The second game moved ahead of the first\", () => pm.expect(pm.response.json().items.map(game => game.gameId)).to.eql([pm.collectionVariables.get(\"otherWishlistGameId\"), pm.collectionVariables.get(\"wishlistGameId\")]));"
            ]
          }
        }
      ]
    },
    {
      "name": "Remove the second game",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "X-CSRF-Token",
            "value": "{{csrfToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/me/wishlist/games/{{otherWishlistGameId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 204\", () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "Read wishlist-scoped releases",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/me/wishlist/releases?from=2026-02-27&to=2026-02-27&pageSize=1"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Private response is never stored\", () => pm.expect(pm.response.headers.get(\"Cache-Control\")).to.eql(\"no-store\"));",
              "pm.test(\"Only the saved game in this range\", () => { const body = pm.response.json(); pm.expect(body.page.totalItems).to.eql(1); pm.expect(body.items[0].gameId).to.eql(pm.collectionVariables.get(\"wishlistGameId\")); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Read wishlist-scoped calendar",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/me/wishlist/release-calendar"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Private response is never stored\", () => pm.expect(pm.response.headers.get(\"Cache-Control\")).to.eql(\"no-store\"));",
              "pm.test(\"Bounded days and no validator\", () => { pm.expect(pm.response.json().days.length).to.be.at.most(31); pm.expect(pm.response.headers.has(\"ETag\")).to.eql(false); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Remove the game",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "X-CSRF-Token",
            "value": "{{csrfToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/me/wishlist/games/{{wishlistGameId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 204\", () => pm.response.to.have.status(204));",
              "pm.test(\"Private response is never stored\", () => pm.expect(pm.response.headers.get(\"Cache-Control\")).to.eql(\"no-store\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Repeat removal",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "X-CSRF-Token",
            "value": "{{csrfToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/me/wishlist/games/{{wishlistGameId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 204\", () => pm.response.to.have.status(204));",
              "pm.test(\"Private response is never stored\", () => pm.expect(pm.response.headers.get(\"Cache-Control\")).to.eql(\"no-store\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Confirm the collection is empty",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/me/wishlist"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Private response is never stored\", () => pm.expect(pm.response.headers.get(\"Cache-Control\")).to.eql(\"no-store\"));",
              "pm.test(\"No saved games remain\", () => pm.expect(pm.response.json().items).to.eql([]));"
            ]
          }
        }
      ]
    }
  ]
}
