{
  "info": {
    "name": "Private Game Library",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Disposable signed-in account only. Sets, filters and removes the state of one seeded game."
  },
  "variable": [
    {
      "key": "libraryGameId",
      "value": "30000000-0000-4000-8000-000000000005"
    },
    {
      "key": "libraryUpcomingGameId",
      "value": "30000000-0000-4000-8000-000000000008"
    },
    {
      "key": "csrfToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Read signed-in session and CSRF proof",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/session"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Private response is never stored\", () => pm.expect(pm.response.headers.get(\"Cache-Control\")).to.eql(\"no-store\"));",
              "pm.test(\"Authenticated session\", () => pm.expect(pm.response.json().authenticated).to.eql(true));",
              "pm.collectionVariables.set(\"csrfToken\", pm.response.json().csrfToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "Reject a state change without CSRF",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/me/library/games/{{libraryGameId}}",
        "body": {
          "mode": "raw",
          "raw": "{\"state\": \"playing\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 403\", () => pm.response.to.have.status(403));",
              "pm.test(\"Private response is never stored\", () => pm.expect(pm.response.headers.get(\"Cache-Control\")).to.eql(\"no-store\"));",
              "pm.test(\"Stable CSRF problem\", () => pm.expect(pm.response.json().code).to.eql(\"CSRF_VALIDATION_FAILED\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Reject an unknown command property",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "X-CSRF-Token",
            "value": "{{csrfToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/me/library/games/{{libraryGameId}}",
        "body": {
          "mode": "raw",
          "raw": "{\"state\": \"playing\", \"userId\": \"00000000-0000-4000-8000-0000000000b1\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 422\", () => pm.response.to.have.status(422));",
              "pm.test(\"Private response is never stored\", () => pm.expect(pm.response.headers.get(\"Cache-Control\")).to.eql(\"no-store\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Reject Jugando for a game that has not come out",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "X-CSRF-Token",
            "value": "{{csrfToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/me/library/games/{{libraryUpcomingGameId}}",
        "body": {
          "mode": "raw",
          "raw": "{\"state\": \"playing\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 422\", () => pm.response.to.have.status(422));",
              "pm.test(\"Only Deseado before a release\", () => pm.expect(pm.response.json().code).to.eql(\"GAME_NOT_RELEASED\"));",
              "pm.test(\"Points at the state\", () => pm.expect(pm.response.json().violations[0].pointer).to.eql(\"/state\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Mark a game as Jugando",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "X-CSRF-Token",
            "value": "{{csrfToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/me/library/games/{{libraryGameId}}",
        "body": {
          "mode": "raw",
          "raw": "{\"state\": \"playing\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 204\", () => pm.response.to.have.status(204));",
              "pm.test(\"Private response is never stored\", () => pm.expect(pm.response.headers.get(\"Cache-Control\")).to.eql(\"no-store\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Repeat the same state",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "X-CSRF-Token",
            "value": "{{csrfToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/me/library/games/{{libraryGameId}}",
        "body": {
          "mode": "raw",
          "raw": "{\"state\": \"playing\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 204\", () => pm.response.to.have.status(204));",
              "pm.test(\"Private response is never stored\", () => pm.expect(pm.response.headers.get(\"Cache-Control\")).to.eql(\"no-store\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Read my state for a bounded set",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/me/library/states?gameIds={{libraryGameId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Private response is never stored\", () => pm.expect(pm.response.headers.get(\"Cache-Control\")).to.eql(\"no-store\"));",
              "pm.test(\"Game is Jugando\", () => pm.expect(pm.response.json().entries).to.eql([{ gameId: pm.collectionVariables.get(\"libraryGameId\"), state: \"playing\" }]));"
            ]
          }
        }
      ]
    },
    {
      "name": "Mark the same game as Completado",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "X-CSRF-Token",
            "value": "{{csrfToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/me/library/games/{{libraryGameId}}",
        "body": {
          "mode": "raw",
          "raw": "{\"state\": \"completed\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 204\", () => pm.response.to.have.status(204));",
              "pm.test(\"Private response is never stored\", () => pm.expect(pm.response.headers.get(\"Cache-Control\")).to.eql(\"no-store\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Page my games filtered by state",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/me/library?state=completed&pageSize=20"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Private response is never stored\", () => pm.expect(pm.response.headers.get(\"Cache-Control\")).to.eql(\"no-store\"));",
              "const body = pm.response.json();",
              "pm.test(\"Only the completed game\", () => pm.expect(body.items.map(game => game.gameId)).to.eql([pm.collectionVariables.get(\"libraryGameId\")]));",
              "pm.test(\"Counts cover every state\", () => { pm.expect(body.counts.completed).to.eql(1); pm.expect(body.counts.playing).to.eql(0); pm.expect(body.counts.total).to.eql(1); });",
              "pm.test(\"Change time is present\", () => pm.expect(body.items[0].stateChangedAt).to.be.a(\"string\"));",
              "pm.test(\"The game has come out\", () => pm.expect(body.items[0].released).to.eql(true));",
              "pm.test(\"Rated games without a state are counted\", () => pm.expect(body.ratedWithoutState).to.be.a(\"number\").and.at.least(0));"
            ]
          }
        }
      ]
    },
    {
      "name": "Reject an unknown state filter",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/me/library?state=finished"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 422\", () => pm.response.to.have.status(422));",
              "pm.test(\"Private response is never stored\", () => pm.expect(pm.response.headers.get(\"Cache-Control\")).to.eql(\"no-store\"));",
              "pm.test(\"Stable filter problem\", () => pm.expect(pm.response.json().code).to.eql(\"FILTER_INVALID\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Mark my rated games without a state as Completado",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-CSRF-Token",
            "value": "{{csrfToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/me/library/rated-games/completion"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Private response is never stored\", () => pm.expect(pm.response.headers.get(\"Cache-Control\")).to.eql(\"no-store\"));",
              "pm.test(\"One bounded batch\", () => pm.expect(pm.response.json().completed).to.be.within(0, 1000));"
            ]
          }
        }
      ]
    },
    {
      "name": "Remove the game from my library",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "X-CSRF-Token",
            "value": "{{csrfToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/me/library/games/{{libraryGameId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 204\", () => pm.response.to.have.status(204));",
              "pm.test(\"Private response is never stored\", () => pm.expect(pm.response.headers.get(\"Cache-Control\")).to.eql(\"no-store\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Repeat the removal",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "X-CSRF-Token",
            "value": "{{csrfToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/me/library/games/{{libraryGameId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 204\", () => pm.response.to.have.status(204));",
              "pm.test(\"Private response is never stored\", () => pm.expect(pm.response.headers.get(\"Cache-Control\")).to.eql(\"no-store\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Read an empty library",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/me/library"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Private response is never stored\", () => pm.expect(pm.response.headers.get(\"Cache-Control\")).to.eql(\"no-store\"));",
              "pm.test(\"No entries remain\", () => pm.expect(pm.response.json().counts.total).to.eql(0));"
            ]
          }
        }
      ]
    }
  ]
}
