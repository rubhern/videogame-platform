{
  "info": {
    "_postman_id": "fd69b8fd-8e04-5e90-b8d9-bfb0e6cea534",
    "name": "VideoGame Platform Backend - Platform Games",
    "description": "Executable examples for the OpenAPI GET /api/v1/platform-games contract (UC-019, Explorar catálogo) implemented through the Maven-generated PlatformCatalogueApi interface and one bounded PostgreSQL statement per page. Runs against the local database; no provider credential or request-path provider call is required.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "platformGamesEtag",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Featured platform without a query",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
              "",
              "pm.test(\"Response follows the reviewed platform-games-page contract\", function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body).to.have.all.keys(\"platforms\", \"availableFilters\", \"items\", \"page\");",
              "    pm.expect(body.page).to.have.all.keys(\"number\", \"size\", \"totalItems\", \"totalPages\");",
              "    pm.expect(body.items.length).to.be.at.most(body.page.size);",
              "    pm.expect(body.availableFilters.genres).to.be.an(\"array\");",
              "    body.items.forEach(function (item) {",
              "        pm.expect(item).to.include.all.keys(\"gameId\", \"slug\", \"canonicalTitle\", \"primaryCover\", \"genres\", \"platformRelease\", \"scores\");",
              "        pm.expect(item.genres.length).to.be.at.most(2);",
              "        pm.expect(item.platformRelease).to.have.all.keys(\"platform\", \"region\", \"releaseDate\", \"status\");",
              "        pm.expect(item.platformRelease.status).to.not.eql(\"cancelled\");",
              "    });",
              "});",
              "",
              "pm.test(\"Each game appears once and only from the requested platform scope\", function () {",
              "    const body = pm.response.json();",
              "    const scope = body.platforms.map(function (platform) { return platform.platformId; });",
              "    const ids = body.items.map(function (item) { return item.gameId; });",
              "    pm.expect(new Set(ids).size).to.eql(ids.length);",
              "    body.items.forEach(function (item) { pm.expect(scope).to.include(item.platformRelease.platform.platformId); });",
              "});",
              "",
              "pm.test(\"Public scores always revalidate and carry a strong validator\", function () {",
              "    pm.expect(pm.response.headers.get(\"X-Correlation-ID\")).to.be.a(\"string\").and.not.empty;",
              "    pm.expect(pm.response.headers.get(\"Cache-Control\")).to.eql(\"public, no-cache\");",
              "    pm.expect(pm.response.headers.get(\"ETag\")).to.match(/^\"[0-9a-f]{64}\"$/);",
              "    pm.collectionVariables.set(\"platformGamesEtag\", pm.response.headers.get(\"ETag\"));",
              "});",
              "",
              "pm.test(\"The default order puts the latest known date first and an unknown date last\", function () {",
              "    const items = pm.response.json().items;",
              "    let seenUnknown = false;",
              "    items.forEach(function (item) {",
              "        const unknown = item.platformRelease.releaseDate.precision === \"unknown\";",
              "        if (!unknown) pm.expect(seenUnknown).to.eql(false);",
              "        seenUnknown = seenUnknown || unknown;",
              "    });",
              "});"
            ],
            "type": "text/javascript",
            "packages": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/platform-games?platformIds=10000000-0000-4000-8000-000000000001&pageSize=24",
          "host": [
            "{{baseUrl}}"
          ],
