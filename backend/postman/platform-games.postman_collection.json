            "platform-games"
          ],
          "query": [
            {
              "key": "platformIds",
              "value": "10000000-0000-4000-8000-000000000001"
            },
            {
              "key": "pageSize",
              "value": "24"
            }
          ]
        },
        "description": "UC-019: every locally known game of PlayStation 5, without typing. PostgreSQL keeps one presented release per game on the scope, filters, counts, orders by the latest presented date and pages; a fresh seeded database may hold few games, and an empty page is a valid outcome."
      },
      "response": []
