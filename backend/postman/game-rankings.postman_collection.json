{
  "info": {
    "_postman_id": "50a507f2-181b-51d0-b240-67c96a4f0970",
    "name": "VideoGame Platform Backend - Game Rankings",
    "description": "Executable examples for the OpenAPI GET /api/v1/game-rankings contract (UC-018, TOPómetro) implemented through the Maven-generated RankingsApi interface and bounded PostgreSQL ranking queries. Runs against the local database; no provider credential or request-path provider call is required.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "rankingEtag",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "IGDB players ranking by default",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
              "",
              "pm.test(\"Response follows the reviewed game-ranking-page contract\", function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body).to.have.all.keys(\"source\", \"items\", \"page\");",
              "    pm.expect(body.page).to.have.all.keys(\"number\", \"size\", \"totalItems\", \"totalPages\");",
              "    pm.expect(body.items.length).to.be.at.most(body.page.size);",
              "    body.items.forEach(function (item) {",
              "        pm.expect(item).to.have.all.keys(\"position\", \"gameId\", \"slug\", \"canonicalTitle\", \"primaryCover\", \"genres\", \"releaseSummary\", \"score\");",
              "        pm.expect(item.genres.length).to.be.at.most(2);",
              "        pm.expect(item.releaseSummary.platforms.length).to.be.at.most(3);",
              "        pm.expect(item.score.scale).to.eql(10);",
              "        pm.expect(item.score.count).to.be.a(\"number\").and.at.least(100);",
              "        pm.expect(item.score.value).to.be.within(0, 10);",
              "    });",
              "});",
              "",
              "pm.test(\"Positions continue the one sequence and no game repeats\", function () {",
              "    const body = pm.response.json();",
              "    const first = (body.page.number - 1) * body.page.size + 1;",
              "    body.items.forEach(function (item, index) { pm.expect(item.position).to.eql(first + index); });",
              "    const ids = body.items.map(function (item) { return item.gameId; });",
              "    pm.expect(new Set(ids).size).to.eql(ids.length);",
              "});",
              "",
              "pm.test(\"Displayed scores never rise down the ranking\", function () {",
              "    const values = pm.response.json().items.map(function (item) { return item.score.value; });",
              "    for (let i = 1; i < values.length; i++) pm.expect(values[i]).to.be.at.most(values[i - 1]);",
              "});",
              "",
              "pm.test(\"Public scores always revalidate and carry a strong validator\", function () {",
              "    pm.expect(pm.response.headers.get(\"X-Correlation-ID\")).to.be.a(\"string\").and.not.empty;",
              "    pm.expect(pm.response.headers.get(\"Cache-Control\")).to.eql(\"public, no-cache\");",
              "    pm.expect(pm.response.headers.get(\"ETag\")).to.match(/^\"[0-9a-f]{64}\"$/);",
              "});",
              "",
              "pm.test(\"The default source is the IGDB players rating, attributed and never blended\", function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.source).to.eql(\"igdb_players\");",
              "    body.items.forEach(function (item) {",
              "        pm.expect(item.score.source).to.eql(\"igdb\");",
              "        pm.expect(item.score.kind).to.eql(\"player\");",
              "        pm.expect(item.score.attribution.label).to.eql(\"Jugadores IGDB\");",
              "        pm.expect(item.score.attribution.sourceUrl).to.match(/^https:\\/\\/www\\.igdb\\.com\\/games\\//);",
              "    });",
              "    pm.collectionVariables.set(\"rankingEtag\", pm.response.headers.get(\"ETag\"));",
              "});"
            ],
            "type": "text/javascript",
            "packages": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/game-rankings?pageSize=20",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "game-rankings"
          ],
          "query": [
            {
              "key": "pageSize",
              "value": "20"
            }
          ]
        },
        "description": "UC-018: the IGDB players ranking of released games. PostgreSQL ranks by the unrounded mean, then the rating count, then the unique gameId; only games with at least 100 IGDB ratings take part, and a game without a score is absent, never zero. A fresh seeded database holds no scores, so an empty page is a valid outcome."
      },
      "response": []
    },
    {
      "name": "Conditional ranking read",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"An unchanged ranking revalidates without a body\", function () {",
              "    pm.response.to.have.status(304);",
              "    pm.expect(pm.response.text()).to.eql(\"\");",
              "    pm.expect(pm.response.headers.get(\"ETag\")).to.eql(pm.collectionVariables.get(\"rankingEtag\"));",
              "});"
            ],
            "type": "text/javascript",
            "packages": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          },
          {
            "key": "If-None-Match",
            "value": "{{rankingEtag}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/game-rankings?pageSize=20",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "game-rankings"
          ],
          "query": [
            {
              "key": "pageSize",
              "value": "20"
            }
          ]
        },
        "description": "The validator covers every position and reading, so a score change produces a new representation."
      },
      "response": []
    },
