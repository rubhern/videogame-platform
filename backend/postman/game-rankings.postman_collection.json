              "    pm.expect(body.page.number).to.eql(2);",
              "    body.items.forEach(function (item) {",
              "        pm.expect(item.score).to.have.all.keys(\"source\", \"kind\", \"value\", \"scale\", \"count\");",
              "        pm.expect(item.score.source).to.eql(\"gameometro\");",
              "        pm.expect(item.score.kind).to.eql(\"community\");",
              "        pm.expect(item.score.value).to.be.within(1, 10);",
              "    });",
              "});"
            ],
            "type": "text/javascript",
            "packages": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
