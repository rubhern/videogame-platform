              "    const titles = body.items.map(function (item) { return item.canonicalTitle; });",
              "    pm.expect(titles).to.eql([\"Death Stranding 2: On the Beach\", \"Subnautica 2\"]);",
              "    const ids = body.items.map(function (item) { return item.gameId; });",
              "    pm.expect(new Set(ids).size).to.eql(ids.length);",
              "});"
