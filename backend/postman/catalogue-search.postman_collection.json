{
  "info": {
    "_postman_id": "2705ffc0-42ac-5cc7-bdc7-a81c8d9b337a",
    "name": "VideoGame Platform Backend - Catalogue Search",
    "description": "Executable examples for the OpenAPI 1.2.2 GET /api/v1/games contract implemented through the Maven-generated CatalogueApi interface and a bounded PostgreSQL search query. Run against a disposable local database initialized with the tracked development seed; no provider credential or request-path provider call is required.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "searchEtag",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Canonical title search",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response follows the reviewed game-search-page contract\", function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body).to.have.all.keys(\"items\", \"page\");",
              "    pm.expect(body.page.number).to.eql(1);",
              "    pm.expect(body.page.size).to.eql(20);",
              "    pm.expect(body.page.totalItems).to.be.a(\"number\").and.at.least(1);",
              "    pm.expect(body.page.totalPages).to.be.a(\"number\").and.at.least(1);",
              "    body.items.forEach(function (item) {",
              "        pm.expect(item).to.include.all.keys(\"gameId\", \"slug\", \"canonicalTitle\", \"primaryCover\", \"releaseContext\");",
              "        pm.expect([\"provider\", \"fallback\"]).to.include(item.primaryCover.kind);",
              "        item.releaseContext.forEach(function (context) {",
              "            pm.expect(context).to.include.all.keys(\"platform\", \"region\", \"releaseDate\", \"status\", \"freshnessStatus\");",
              "            pm.expect([\"day\", \"month\", \"quarter\", \"year\", \"unknown\"]).to.include(context.releaseDate.precision);",
              "            pm.expect([\"fresh\", \"stale\"]).to.include(context.freshnessStatus);",
              "        });",
              "    });",
              "});",
              "",
              "pm.test(\"Search returns the matching catalogue game\", function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.page.totalItems).to.eql(1);",
              "    pm.expect(body.items[0].canonicalTitle).to.eql(\"Resident Evil Requiem\");",
              "    pm.expect(body.items[0].slug).to.eql(\"resident-evil-requiem\");",
              "});",
              "",
              "pm.test(\"No provider identifier or raw provider record is exposed\", function () {",
              "    pm.expect(pm.response.text().toLowerCase()).to.not.include(\"igdb\");",
              "});",
              "",
              "pm.test(\"Public cache and correlation headers are present\", function () {",
              "    pm.expect(pm.response.headers.get(\"X-Correlation-ID\")).to.be.a(\"string\").and.not.empty;",
              "    pm.expect(pm.response.headers.get(\"Cache-Control\")).to.include(\"public\");",
              "    pm.expect(pm.response.headers.get(\"ETag\")).to.match(/^\"[0-9a-f]{64}\"$/);",
              "});",
              "",
              "pm.collectionVariables.set(\"searchEtag\", pm.response.headers.get(\"ETag\"));"
            ],
            "type": "text/javascript",
            "packages": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/games?q=resident%20evil&page=1&pageSize=20",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "games"
          ],
          "query": [
            {
              "key": "q",
              "value": "resident evil"
            },
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "pageSize",
              "value": "20"
            }
          ]
        },
        "description": "Searches only the bounded local catalogue. PostgreSQL matches, ranks, counts and pages; ordering ends with the unique gameId of a one-row-per-game result."
      },
      "response": []
    },
