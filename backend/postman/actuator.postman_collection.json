{
  "info": {
    "_postman_id": "b4809a0d-07fe-4eb3-b232-491bb0759df3",
    "name": "VideoGame Platform Backend - Actuator",
    "description": "Read-only operational checks for every Spring Boot Actuator endpoint exposed by the backend walking skeleton. Select the VideoGame Platform - Local environment before running the collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Discovery",
      "item": [
        {
          "name": "Actuator index",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response exposes only the expected resource links\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.have.property(\"_links\");",
                  "    pm.expect(body._links).to.have.all.keys(\"self\", \"health\", \"health-path\", \"info\", \"metrics\", \"metrics-requiredMetricName\");",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{managementBaseUrl}}/actuator",
              "host": [
                "{{managementBaseUrl}}"
              ],
              "path": [
                "actuator"
              ]
            },
            "description": "Returns hypermedia links for the Actuator resources exposed over HTTP."
          },
          "response": []
        },
        {
          "name": "Product port excludes Actuator",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 404\", function () {",
                  "    pm.response.to.have.status(404);",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/actuator/metrics",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "actuator",
                "metrics"
              ]
            },
            "description": "Confirms that operational metrics are absent from the product HTTP surface."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Health",
      "item": [
        {
          "name": "Aggregate health",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Application health is UP and publishes both probe groups\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.status).to.eql(\"UP\");",
                  "    pm.expect(body.groups).to.have.members([\"liveness\", \"readiness\"]);",
                  "    pm.expect(body).not.to.have.property(\"components\");",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{managementBaseUrl}}/actuator/health",
              "host": [
                "{{managementBaseUrl}}"
              ],
              "path": [
                "actuator",
                "health"
              ]
            },
            "description": "Returns the aggregate application health. Component details are deliberately hidden."
          },
          "response": []
        },
        {
          "name": "Liveness probe",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Liveness is UP\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.eql({ status: \"UP\" });",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{managementBaseUrl}}/actuator/health/liveness",
              "host": [
                "{{managementBaseUrl}}"
              ],
              "path": [
                "actuator",
                "health",
                "liveness"
              ]
            },
            "description": "Reports whether the process is live and should remain running."
          },
          "response": []
        },
        {
          "name": "Readiness probe",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Readiness is UP\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.eql({ status: \"UP\" });",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{managementBaseUrl}}/actuator/health/readiness",
              "host": [
                "{{managementBaseUrl}}"
              ],
              "path": [
                "actuator",
                "health",
                "readiness"
              ]
            },
            "description": "Reports whether the application is ready to receive traffic."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Information",
      "item": [
        {
          "name": "Application info",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response contains safe build and source metadata\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.build.version).to.eql(\"0.7.6-SNAPSHOT\");",
                  "    pm.expect(body.build.sourceRevision).to.be.a(\"string\").and.not.empty;",
                  "    pm.expect(JSON.stringify(body)).not.to.include(\"password\");",
                  "    pm.expect(JSON.stringify(body)).not.to.include(\"jdbc:\");",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{managementBaseUrl}}/actuator/info",
              "host": [
                "{{managementBaseUrl}}"
              ],
              "path": [
                "actuator",
                "info"
              ]
            },
            "description": "Returns generated non-sensitive build version, time, and source revision information."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Metrics",
      "item": [
        {
          "name": "Metric names",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Baseline HTTP, runtime and pool meters are available\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.names).to.include.members([\"http.server.requests\", \"jvm.memory.used\", \"jdbc.connections.active\", \"catalogue.releases.result.count\"]);",
                  "    pm.expect(body.names).not.to.include.members([\"catalogue.releases.requests\", \"catalogue.releases.latency\", \"catalogue.releases.failures\"]);",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{managementBaseUrl}}/actuator/metrics",
              "host": [
                "{{managementBaseUrl}}"
              ],
              "path": [
                "actuator",
                "metrics"
              ]
            },
            "description": "Returns names for the bounded in-memory diagnostic meters."
          },
          "response": []
        },
        {
          "name": "HTTP request metric",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"HTTP metrics expose bounded route-template tags\", function () {",
                  "    const body = pm.response.json();",
                  "    const uriTag = body.availableTags.find((tag) => tag.tag === \"uri\");",
                  "    pm.expect(uriTag).to.exist;",
                  "    pm.expect(uriTag.values.every((value) => !value.includes(\"?\"))).to.be.true;",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{managementBaseUrl}}/actuator/metrics/http.server.requests",
              "host": [
                "{{managementBaseUrl}}"
              ],
              "path": [
                "actuator",
                "metrics",
                "http.server.requests"
              ]
            },
            "description": "Returns HTTP request measurements and bounded route-template tag values."
          },
          "response": []
        }
      ]
    }
  ]
}
