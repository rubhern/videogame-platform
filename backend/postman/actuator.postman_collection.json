{
  "info": {
    "_postman_id": "b4809a0d-07fe-4eb3-b232-491bb0759df3",
    "name": "VideoGame Platform Backend - Actuator",
    "description": "Read-only operational checks for the Spring Boot Actuator endpoints exposed by the backend, plus the internal catalogue-synchronization operator command exercised in its safe credential-free form. Select the VideoGame Platform - Local environment before running the collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Discovery",
      "item": [
        {
          "name": "Actuator index",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response exposes only the expected resource links\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.have.property(\"_links\");",
                  "    pm.expect(body._links).to.have.all.keys(\"self\", \"health\", \"health-path\", \"info\", \"metrics\", \"metrics-requiredMetricName\", \"cataloguesync\");",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{managementBaseUrl}}/actuator",
              "host": [
                "{{managementBaseUrl}}"
              ],
              "path": [
                "actuator"
              ]
            },
            "description": "Returns hypermedia links for the Actuator resources exposed over HTTP."
          },
          "response": []
        },
        {
          "name": "Product port excludes Actuator",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 404\", function () {",
                  "    pm.response.to.have.status(404);",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/actuator/metrics",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "actuator",
                "metrics"
              ]
            },
            "description": "Confirms that operational metrics are absent from the product HTTP surface."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Health",
      "item": [
        {
          "name": "Aggregate health",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Application health is UP and publishes both probe groups\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.status).to.eql(\"UP\");",
                  "    pm.expect(body.groups).to.have.members([\"liveness\", \"readiness\"]);",
                  "    pm.expect(body).not.to.have.property(\"components\");",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{managementBaseUrl}}/actuator/health",
              "host": [
                "{{managementBaseUrl}}"
              ],
              "path": [
                "actuator",
                "health"
              ]
            },
            "description": "Returns the aggregate application health. Component details are deliberately hidden."
          },
          "response": []
        },
        {
          "name": "Liveness probe",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Liveness is UP\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.eql({ status: \"UP\" });",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{managementBaseUrl}}/actuator/health/liveness",
              "host": [
                "{{managementBaseUrl}}"
              ],
              "path": [
                "actuator",
                "health",
                "liveness"
              ]
            },
            "description": "Reports whether the process is live and should remain running."
          },
          "response": []
        },
        {
          "name": "Readiness probe",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Readiness is UP\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.eql({ status: \"UP\" });",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{managementBaseUrl}}/actuator/health/readiness",
              "host": [
                "{{managementBaseUrl}}"
              ],
              "path": [
                "actuator",
                "health",
                "readiness"
              ]
            },
            "description": "Reports whether the application is ready to receive traffic."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Information",
      "item": [
        {
          "name": "Application info",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response contains safe build and source metadata\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.build.version).to.match(/^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$/);",
                  "    pm.expect(body.build.sourceRevision).to.be.a(\"string\").and.not.empty;",
                  "    pm.expect(JSON.stringify(body)).not.to.include(\"password\");",
                  "    pm.expect(JSON.stringify(body)).not.to.include(\"jdbc:\");",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{managementBaseUrl}}/actuator/info",
              "host": [
                "{{managementBaseUrl}}"
              ],
              "path": [
                "actuator",
                "info"
              ]
            },
            "description": "Returns generated non-sensitive build version, time, and source revision information."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Metrics",
      "item": [
        {
          "name": "Metric names",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Baseline HTTP, runtime and pool meters are available\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.names).to.include.members([\"http.server.requests\", \"jvm.memory.used\", \"jdbc.connections.active\", \"catalogue.releases.result.count\"]);",
                  "    pm.expect(body.names).not.to.include.members([\"catalogue.releases.requests\", \"catalogue.releases.latency\", \"catalogue.releases.failures\"]);",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{managementBaseUrl}}/actuator/metrics",
              "host": [
                "{{managementBaseUrl}}"
              ],
              "path": [
                "actuator",
                "metrics"
              ]
            },
            "description": "Returns names for the bounded in-memory diagnostic meters."
          },
          "response": []
        },
        {
          "name": "HTTP request metric",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"HTTP metrics expose bounded route-template tags\", function () {",
                  "    const body = pm.response.json();",
                  "    const uriTag = body.availableTags.find((tag) => tag.tag === \"uri\");",
                  "    pm.expect(uriTag).to.exist;",
                  "    pm.expect(uriTag.values.every((value) => !value.includes(\"?\"))).to.be.true;",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{managementBaseUrl}}/actuator/metrics/http.server.requests",
              "host": [
                "{{managementBaseUrl}}"
              ],
              "path": [
                "actuator",
                "metrics",
                "http.server.requests"
              ]
            },
            "description": "Returns HTTP request measurements and bounded route-template tag values."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Catalogue synchronization",
      "description": "Synchronize every IGDB Game represented in an inclusive operator-selected release-date interval. Paging is internal and imposes no total Game limit. No provider credentials are used in this automated collection.",
      "item": [
        {
          "name": "Last synchronization run",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Reports the last run without provider detail\", function () {",
                  "    const body = pm.response.json();",
                  "    // Either no run has happened yet, or a bounded run report is returned.",
                  "    if (body.status === \"never_run\") {",
                  "        pm.expect(Object.keys(body)).to.eql([\"status\"]);",
                  "    } else {",
                  "        pm.expect(body).to.have.property(\"outcome\");",
                  "        pm.expect(body).to.have.property(\"outcomeCode\");",
                  "    }",
                  "    pm.expect(body).not.to.have.property(\"clientSecret\");",
                  "    pm.expect(body).not.to.have.property(\"provider\");",
                  "    pm.expect(body).not.to.have.property(\"providerId\");",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{managementBaseUrl}}/actuator/cataloguesync",
              "host": [
                "{{managementBaseUrl}}"
              ],
              "path": [
                "actuator",
                "cataloguesync"
              ]
            },
            "description": "Reports the most recent recorded synchronization run, or never_run, with bounded counts and stable codes only."
          },
          "response": []
        },
        {
          "name": "Synchronize date interval (disabled without credentials)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"One complete date-window operation without a mode or Game limit\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).not.to.have.property(\"mode\");",
                  "    pm.expect(body).not.to.have.property(\"checkpoint\");",
                  "    pm.expect(body.counters).not.to.have.property(\"candidateGames\");",
                  "});",
                  "",
                  "pm.test(\"Disabled without provider credentials; nothing is synchronized\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.outcome).to.eql(\"SKIPPED\");",
                  "    pm.expect(body.outcomeCode).to.eql(\"SYNCHRONIZATION_DISABLED\");",
                  "});",
                  "",
                  "pm.test(\"Response never carries a credential or provider identity\", function () {",
                  "    const raw = pm.response.text();",
                  "    pm.expect(raw).to.not.include(\"clientSecret\");",
                  "    pm.expect(raw).to.not.include(\"igdb.com\");",
                  "});",
                  "",
                  "pm.test(\"Request has dates and no batch size\", function () {",
                  "    const request = JSON.parse(pm.request.body.raw);",
                  "    pm.expect(request).to.eql({from: \"2026-01-01\", to: \"2026-12-31\"});",
                  "    pm.expect(request).not.to.have.property(\"batchSize\");",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"from\":\"2026-01-01\",\"to\":\"2026-12-31\"}"
            },
            "url": {
              "raw": "{{managementBaseUrl}}/actuator/cataloguesync",
              "host": [
                "{{managementBaseUrl}}"
              ],
              "path": [
                "actuator",
                "cataloguesync"
              ]
            },
            "description": "Synchronize the complete inclusive date interval; without configured credentials no state changes."
          },
          "response": []
        }
      ]
    }
  ]
}
