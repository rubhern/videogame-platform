{
  "info": {
    "_postman_id": "b4809a0d-07fe-4eb3-b232-491bb0759df3",
    "name": "VideoGame Platform Backend - Actuator",
    "description": "Read-only operational checks for every Spring Boot Actuator endpoint exposed by the backend walking skeleton. Select the VideoGame Platform - Local environment before running the collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Discovery",
      "item": [
        {
          "name": "Actuator index",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response exposes only the expected resource links\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.have.property(\"_links\");",
                  "    pm.expect(body._links).to.have.all.keys(\"self\", \"health\", \"health-path\", \"info\");",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/actuator",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "actuator"
              ]
            },
            "description": "Returns hypermedia links for the Actuator resources exposed over HTTP."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Health",
      "item": [
        {
          "name": "Aggregate health",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Application health is UP and publishes both probe groups\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.status).to.eql(\"UP\");",
                  "    pm.expect(body.groups).to.have.members([\"liveness\", \"readiness\"]);",
                  "    pm.expect(body).not.to.have.property(\"components\");",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/actuator/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "actuator",
                "health"
              ]
            },
            "description": "Returns the aggregate application health. Component details are deliberately hidden."
          },
          "response": []
        },
        {
          "name": "Liveness probe",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Liveness is UP\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.eql({ status: \"UP\" });",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/actuator/health/liveness",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "actuator",
                "health",
                "liveness"
              ]
            },
            "description": "Reports whether the process is live and should remain running."
          },
          "response": []
        },
        {
          "name": "Readiness probe",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Readiness is UP\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.eql({ status: \"UP\" });",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/actuator/health/readiness",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "actuator",
                "health",
                "readiness"
              ]
            },
            "description": "Reports whether the application is ready to receive traffic."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Information",
      "item": [
        {
          "name": "Application info",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response is a JSON object\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.be.an(\"object\");",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/actuator/info",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "actuator",
                "info"
              ]
            },
            "description": "Returns non-sensitive application information. The walking skeleton currently returns an empty object."
          },
          "response": []
        }
      ]
    }
  ]
}
