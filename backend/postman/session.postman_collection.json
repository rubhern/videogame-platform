{
  "info": {
    "_postman_id": "4c9dc52f-47d7-4209-afeb-5c5de51d6dc7",
    "name": "VideoGame Platform Backend - BFF Session",
    "description": "Executable anonymous-session, CSRF rejection and logout-completion examples for the contract-first same-origin BFF boundary. Complete OIDC login and logout through Keycloak remain real-browser flows.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Read anonymous session",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Anonymous state is minimal and not cacheable\", function () {",
              "    pm.expect(pm.response.json()).to.eql({ authenticated: false });",
              "    pm.expect(pm.response.headers.get(\"Cache-Control\")).to.include(\"no-store\");",
              "});"
            ],
            "type": "text/javascript",
            "packages": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/session",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "session"
          ]
        },
        "description": "Returns the exact anonymous session representation without creating CSRF or token material."
      },
      "response": []
    },
    {
      "name": "Reject logout without CSRF material",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 403\", function () {",
              "    pm.response.to.have.status(403);",
              "});",
              "",
              "pm.test(\"Failure uses the stable CSRF problem code\", function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.code).to.eql(\"CSRF_VALIDATION_FAILED\");",
              "    pm.expect(body.status).to.eql(403);",
              "    pm.expect(pm.response.headers.get(\"Cache-Control\")).to.include(\"no-store\");",
              "});"
            ],
            "type": "text/javascript",
            "packages": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/problem+json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/session",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "session"
          ]
        },
        "description": "Demonstrates that logout is state-changing and cannot be invoked without current session-bound CSRF material."
      },
      "response": []
    },
    {
      "name": "Complete logout without a pending logout",
      "protocolProfileBehavior": {
        "followRedirects": false
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Without a pending logout the route only returns home\", function () {",
              "    pm.response.to.have.status(302);",
              "    pm.expect(pm.response.headers.get(\"Location\")).to.eql(\"/\");",
              "    pm.expect(pm.response.headers.get(\"Cache-Control\")).to.include(\"no-store\");",
              "    pm.expect(pm.response.headers.has(\"Set-Cookie\")).to.eql(false);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/auth/logout",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "logout"
          ]
        },
        "description": "BFF navigation outside the JSON API. After a successful POST /api/v1/session the browser navigates here and is redirected once through Keycloak's OIDC end-session endpoint; run anonymously, it changes nothing and returns to the landing page. The real redirect is covered by the browser identity gate."
      },
      "response": []
    },
    {
      "name": "Start account entry with a safe local return",
      "protocolProfileBehavior": {
        "followRedirects": false
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Navigation uses the existing OIDC entry and is not cached\", function () {",
              "    pm.response.to.have.status(302);",
              "    pm.expect(pm.response.headers.get(\"Location\")).to.eql(\"/auth/login/keycloak\");",
              "    pm.expect(pm.response.headers.get(\"Cache-Control\")).to.include(\"no-store\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/auth/start?returnTo=%2Fsearch%3Fq%3Dzelda",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "start"
          ],
          "query": [
            {
              "key": "returnTo",
              "value": "%2Fsearch%3Fq%3Dzelda"
            }
          ]
        },
        "description": "BFF authentication navigation outside the JSON API. Run anonymously with redirect following disabled. Malicious target rejection and callback consumption are covered by focused backend/browser tests."
      },
      "response": []
    },
    {
      "name": "Start hosted self-registration with a safe local return",
      "protocolProfileBehavior": {
        "followRedirects": false
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Navigation uses the existing OIDC entry and is not cached\", function () {",
              "    pm.response.to.have.status(302);",
              "    pm.expect(pm.response.headers.get(\"Location\")).to.eql(\"/auth/login/keycloak?intent=register\");",
              "    pm.expect(pm.response.headers.get(\"Cache-Control\")).to.include(\"no-store\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/auth/start?returnTo=%2Fsearch%3Fq%3Dzelda&intent=register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "start"
          ],
          "query": [
            {
              "key": "returnTo",
              "value": "%2Fsearch%3Fq%3Dzelda"
            },
            {
              "key": "intent",
              "value": "register"
            }
          ]
        },
        "description": "Starts the existing BFF/OIDC transaction with the closed registration intent. The authorization resolver adds supported prompt=create without accepting browser-supplied state, nonce or PKCE material."
      },
      "response": []
    },
    {
      "name": "Catalogue administration requires a session",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/admin/catalogue/synchronization",
        "description": "While signed out, operator reads answer 401 without a redirect."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));",
              "pm.test(\"Problem Details are private and correlated\", () => {",
              "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\");",
              "    pm.expect(pm.response.headers.get(\"Cache-Control\")).to.eql(\"no-store\");",
              "    pm.expect(pm.response.json().correlationId).to.eql(pm.response.headers.get(\"X-Correlation-ID\"));",
              "});",
              "pm.test(\"Stable code AUTHENTICATION_REQUIRED\", () => pm.expect(pm.response.json().code).to.eql(\"AUTHENTICATION_REQUIRED\"));",
              "pm.test(\"Fetches are not redirected\", () => pm.expect(pm.response.headers.get(\"Location\")).to.eql(undefined));"
            ]
          }
        }
      ]
    }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.response.code === 503 && pm.response.json().code === \"SERVICE_OVERLOADED\") {",
          "    pm.test(\"Capacity rejection is safe and correlated\", function () {",
          "        pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\");",
          "        pm.expect(pm.response.headers.get(\"Cache-Control\")).to.include(\"no-store\");",
          "        pm.expect(pm.response.headers.get(\"Retry-After\")).to.eql(\"1\");",
          "        pm.expect(pm.response.json().correlationId).to.eql(pm.response.headers.get(\"X-Correlation-ID\"));",
          "    });",
          "}"
        ]
      }
    }
  ]
}
