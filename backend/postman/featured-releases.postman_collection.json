        "header": [
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/featured-releases?view=featured",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "featured-releases"
          ],
          "query": [
            {
              "key": "view",
              "value": "featured"
            }
          ]
        },
        "description": "The browser view state lives in the frontend URL only; the API rejects parameters outside its contract instead of ignoring them."
      },
      "response": []
    }
  ],
