{
  "info": {
    "_postman_id": "d7536974-6718-4a22-bc57-99ae1744faf6",
    "name": "VideoGame Platform Backend - Web Analytics",
    "description": "Executable example of the public, non-personal product analytics configuration (UC-022, #507). Local and private-dev deployments configure no measurement ID, so the default run expects analytics to be off.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Read analytics configuration",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Configuration is public, cacheable and never personal\", function () {",
              "    const cacheControl = pm.response.headers.get(\"Cache-Control\");",
              "    pm.expect(cacheControl).to.include(\"public\");",
              "    pm.expect(cacheControl).to.include(\"max-age=\");",
              "    pm.expect(pm.response.headers.has(\"Set-Cookie\")).to.eql(false);",
              "    pm.expect(pm.response.headers.get(\"X-Correlation-ID\")).to.be.a(\"string\");",
              "});",
              "",
              "pm.test(\"Analytics is off or names one GA4 measurement ID\", function () {",
              "    const body = pm.response.json();",
              "    pm.expect(Object.keys(body)).to.satisfy(keys => keys.every(key => key === \"googleAnalytics\"));",
              "    if (body.googleAnalytics) {",
              "        pm.expect(Object.keys(body.googleAnalytics)).to.eql([\"measurementId\"]);",
              "        pm.expect(body.googleAnalytics.measurementId).to.match(/^G-[A-Z0-9]{4,20}$/);",
              "    } else {",
              "        pm.expect(body).to.eql({});",
              "    }",
              "});"
            ],
            "type": "text/javascript",
            "packages": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/web-analytics",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "web-analytics"
          ]
        },
        "description": "Returns the deployment's GA4 measurement ID, or an empty object when the deployment measures nothing. It never reports a visitor's consent."
      },
      "response": []
    }
  ]
}
