              "});",
              "",
              "pm.test(\"The family is named by both product platforms\", function () {",
              "    pm.expect(pm.response.json().platforms.length).to.eql(2);",
              "});"
            ],
            "type": "text/javascript",
            "packages": {}
          }
        }
      ],
      "request": {
