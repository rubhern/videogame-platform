          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 422\", function () { pm.response.to.have.status(422); });",
              "pm.test(\"An unknown platform is a stable validation error\", function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.code).to.eql(\"PLATFORM_NOT_SUPPORTED\");",
              "    pm.expect(body.violations[0].pointer).to.eql(\"/query/platformIds\");",
              "});"
            ],
            "type": "text/javascript",
            "packages": {}
          }
        }
      ],
