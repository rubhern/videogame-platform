              "pm.test(\"A missing scope is a malformed request\", function () {",
              "    pm.expect(pm.response.json().code).to.eql(\"REQUEST_MALFORMED\");",
              "});"
            ],
            "type": "text/javascript",
            "packages": {}
          }
        }
