    classDef adapter fill:#eefcf3,stroke:#16a34a,stroke-width:1.5px,color:#14532d
    classDef contract fill:#fff7ed,stroke:#ea580c,stroke-width:2px,color:#7c2d12
    class Catalogue,Ratings domain
    class IGDB,IdP,Telemetry external
    class Observability,IdentityAdapter,ACL adapter
